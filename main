# ---------- ЗАПУСК / ОСТАНОВКА РАССЫЛКИ ----------
@dp.message(F.text == "▶️ Запустить рассылку")
async def start_mailing(message: types.Message):
    user_id = message.from_user.id
    job_id = await get_job_id(user_id)
    if job_id:
        try:
            scheduler.get_job(job_id)
            await message.answer("Рассылка уже запущена.")
            return
        except JobLookupError:
            await delete_job_id(user_id)

    accounts = await get_accounts(user_id)
    active_accounts = [a for a in accounts if a['is_active']]
    if not active_accounts:
        await message.answer("Нет активных аккаунтов.")
        return
    for acc in active_accounts:
        if not acc['chats']:
            await message.answer(f"У аккаунта @{acc['username'] if acc['username'] else 'без ника'} нет чатов.")
            return
    messages = await get_messages(user_id)
    if not messages:
        await message.answer("Нет сообщений для рассылки.")
        return

    await start_scheduler_for_user(user_id)
    asyncio.create_task(send_messages_for_user(user_id))

    kb = ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="📋 Аккаунты")],
            [KeyboardButton(text="🔍 Поиск чатов")],
            [KeyboardButton(text="⚙️ Настройки")],
            [KeyboardButton(text="⏹ Остановить рассылку")]
        ],
        resize_keyboard=True
    )
    await message.answer("Рассылка запущена! Первая отправка выполнена.", reply_markup=kb)

@dp.message(F.text == "⏹ Остановить рассылку")
async def stop_mailing(message: types.Message):
    user_id = message.from_user.id
    await stop_scheduler_for_user(user_id)
    kb = ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="📋 Аккаунты")],
            [KeyboardButton(text="🔍 Поиск чатов")],
            [KeyboardButton(text="⚙️ Настройки")],
            [KeyboardButton(text="▶️ Запустить рассылку")]
        ],
        resize_keyboard=True
    )
    await message.answer("Рассылка остановлена.", reply_markup=kb)

# ---------- ВОЗВРАТ В ГЛАВНОЕ МЕНЮ ----------
@dp.message(F.text == "🔙 Назад")
async def back_to_main(message: types.Message):
    await message.answer("Главное меню:", reply_markup=main_keyboard())

# ---------- ЗАПУСК ----------
async def main():
    await init_db()
    bot = Bot(token=BOT_TOKEN)
    await restore_schedulers_on_startup()
    if not scheduler.running:
        scheduler.start()
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
