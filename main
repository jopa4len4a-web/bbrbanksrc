@dp.message(F.text == "📋 Аккаунты")
async def kb_accounts(m: types.Message):
    await ensure_user(m.from_user.id, m.from_user.username)
    accounts = await get_accounts(m.from_user.id)
    if not accounts:
        kb = ReplyKeyboardMarkup(keyboard=[
            [KeyboardButton(text="➕ Добавить аккаунт")],
            [KeyboardButton(text="🔙 Назад")],
        ], resize_keyboard=True)
        await m.answer("Нет аккаунтов.", reply_markup=kb)
    else:
        await m.answer("Твои аккаунты:", reply_markup=accounts_menu_reply(accounts))


@dp.message(F.text == "➕ Добавить аккаунт")
async def addacc_start(m: types.Message, st: FSMContext):
    await m.answer("Введи номер телефона (+7...):")
    await st.set_state(S_acc.phone)


@dp.message(S_acc.phone)
async def addacc_phone(m: types.Message, st: FSMContext):
    phone = m.text.strip()
    if not phone.startswith("+"):
        await m.answer("Номер должен начинаться с +.")
        return
    await st.update_data(phone=phone)
    client = make_client(None)
    await st.update_data(client=client)
    try:
        await client.connect()
        await client.send_code_request(phone)
        await m.answer("Код отправлен. Введи его:")
        await st.set_state(S_acc.code)
    except Exception as e:
        await m.answer(f"Ошибка: {e}")
        await st.clear()
        try:
            await client.disconnect()
        except Exception:
            pass


@dp.message(S_acc.code)
async def addacc_code(m: types.Message, st: FSMContext):
    code = m.text.strip()
    data = await st.get_data()
    client = data.get("client")
    phone = data.get("phone")
    if not client:
        await m.answer("Сессия потеряна.")
        await st.clear()
        return
    try:
        await client.sign_in(phone, code)
        sess = client.session.save()
        me = await client.get_me()
        uname = me.username if me.username else None
        await add_account(m.from_user.id, phone, uname, sess)
        accounts = await get_accounts(m.from_user.id)
        await m.answer("✅ Аккаунт добавлен!", reply_markup=accounts_menu_reply(accounts))
    except SessionPasswordNeededError:
        await m.answer("Введи пароль 2FA:")
        await st.set_state(S_acc.password)
        return
    except Exception as e:
        await m.answer(f"Ошибка: {e}")
    try:
        await client.disconnect()
    except Exception:
        pass
    await st.clear()


@dp.message(S_acc.password)
async def addacc_pwd(m: types.Message, st: FSMContext):
    pwd = m.text.strip()
    data = await st.get_data()
    client = data.get("client")
    phone = data.get("phone")
    if not client:
        await m.answer("Сессия потеряна.")
        await st.clear()
        return
    try:
        await client.sign_in(password=pwd)
        sess = client.session.save()
        me = await client.get_me()
        uname = me.username if me.username else None
        await add_account(m.from_user.id, phone, uname, sess)
        accounts = await get_accounts(m.from_user.id)
        await m.answer("✅ Аккаунт добавлен!", reply_markup=accounts_menu_reply(accounts))
    except Exception as e:
        await m.answer(f"Ошибка: {e}")
    try:
        await client.disconnect()
    except Exception:
        pass
    await st.clear()


@dp.message(F.text.startswith("✅ "))
async def acc_open_ok(m: types.Message):
    await _open_account(m)


@dp.message(F.text.startswith("❌ "))
async def acc_open_no(m: types.Message):
    await _open_account(m)


async def _open_account(m: types.Message):
    parts = m.text.split(" • ")
    if len(parts) < 2:
        return
    phone = parts[1].strip()
    accounts = await get_accounts(m.from_user.id)
    acc = next((a for a in accounts if a["phone"] == phone), None)
    if not acc:
        await m.answer("Не найден.")
        return
    text = (f"📱 @{acc['username'] or 'без ника'}\n📞 {acc['phone']}\n"
            f"✉️ Чатов рассылки: {len(acc['chats'])}\n"
            f"📥 Источников: {len(acc['sources'])}\n"
            f"📤 Цель: {acc['target'].get('title') if acc['target'] else '—'}\n"
            f"📊 Спарсено: {acc['parsed_count']} | 📨 Инвайтов: {acc['invited_count']} | ✉️ Отправлено: {acc['sent_count']}")
    await m.answer(text, reply_markup=account_menu_inline(acc["id"], acc["is_active"]))


# ---------- РАССЫЛКА ----------
@dp.message(F.text == "✉️ Рассылка")
async def kb_mailing(m: types.Message):
    await ensure_user(m.from_user.id, m.from_user.username)
    running = await is_mailing_running(m.from_user.id)
    await m.answer("✉️ Рассылка:", reply_markup=mailing_menu(running))


@dp.callback_query(F.data == "mail_toggle")
async def mail_toggle(cb: types.CallbackQuery):
    uid = cb.from_user.id
    running = await is_mailing_running(uid)
    if running:
        await stop_mailing(uid)
        await cb.answer("Остановлено")
    else:
        accs = [a for a in await get_accounts(uid) if a["is_active"] and a["chats"]]
        if not accs:
            await cb.answer("Нет активных аккаунтов с чатами.", show_alert=True)
            return
        msgs = await get_messages(uid)
        if not msgs:
            await cb.answer("Нет текстов. Добавь в 📝 Тексты.", show_alert=True)
            return
        await start_mailing(uid)
        await cb.answer("Запущено")
    running = await is_mailing_running(uid)
    try:
        await cb.message.edit_reply_markup(reply_markup=mailing_menu(running))
    except TelegramBadRequest:
        pass


@dp.callback_query(F.data == "mail_open")
async def mail_open(cb: types.CallbackQuery):
    running = await is_mailing_running(cb.from_user.id)
    try:
        await cb.message.edit_text("✉️ Рассылка:", reply_markup=mailing_menu(running))
    except TelegramBadRequest:
        pass
    await cb.answer()


@dp.callback_query(F.data == "mail_msgs")
async def mail_msgs(cb: types.CallbackQuery):
    msgs = await get_messages(cb.from_user.id)
    text = "📝 Тексты:\n" + ("\n".join(f"{i+1}. {m['text'][:40]}" for i, m in enumerate(msgs))
                             if msgs else "Пусто.")
    try:
        await cb.message.edit_text(text, reply_markup=messages_menu(msgs))
    except TelegramBadRequest:
        pass
    await cb.answer()


@dp.callback_query(F.data == "msg_add")
async def msg_add(cb: types.CallbackQuery, st: FSMContext):
    await cb.message.answer("Введи текст:")
    await st.set_state(S_set.msg)
    await cb.answer()


@dp.message(S_set.msg)
async def msg_add_save(m: types.Message, st: FSMContext):
    await add_message(m.from_user.id, m.text)
    await m.answer("✅ Добавлено")
    await st.clear()
    msgs = await get_messages(m.from_user.id)
    await m.answer("📝 Тексты:", reply_markup=messages_menu(msgs))


@dp.callback_query(F.data.startswith("msg_del_"))
async def msg_del(cb: types.CallbackQuery):
    mid = int(cb.data.split("_")[2])
    await del_message(mid, cb.from_user.id)
    await cb.answer("Удалено")
    msgs = await get_messages(cb.from_user.id)
    try:
        await cb.message.edit_text("📝 Тексты:", reply_markup=messages_menu(msgs))
    except TelegramBadRequest:
        pass


