            f"📞 Телефон: {me.phone or acc['phone']}\n"
        )
    except Exception as e:
        info_text += f"Ошибка: {e}\n"
    finally:
        await client.disconnect()
    info_text += "\nВыберите:"
    await callback.message.edit_text(info_text, reply_markup=profile_edit_keyboard(account_id))
