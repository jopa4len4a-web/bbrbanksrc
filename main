# ---------- FSM ----------
class AddAccountStates(StatesGroup):
    waiting_phone = State()
    waiting_code = State()
    waiting_password = State()

class EditMessagesStates(StatesGroup):
    waiting_new_message = State()

class AddChatStates(StatesGroup):
    waiting_chat_input = State()

class SearchChatsStates(StatesGroup):
    waiting_query = State()

class FilterStates(StatesGroup):
    waiting_min_participants = State()
    waiting_max_chats = State()
    waiting_activity_days = State()

# ---------- ФУНКЦИЯ ОТПРАВКИ ----------
async def send_messages_for_user(user_id: int):
    try:
        accounts = await get_accounts(user_id)
        if not accounts:
            return
        messages = await get_messages(user_id)
        if not messages:
            return

        for acc in accounts:
            if not acc['is_active']:
                continue
            if not acc['chats']:
                continue
            client = TelegramClient(StringSession(acc['session_string']), API_ID, API_HASH)
            try:
                await client.start()
                for chat in acc['chats']:
                    chat_id = chat['id']
                    for msg in messages:
                        try:
                            await client.send_message(chat_id, msg['text'])
                            await increment_sent_count(acc['id'], user_id)
                            await asyncio.sleep(1)
                        except FloodWaitError as e:
                            logging.warning(f"FloodWait: ждём {e.seconds} сек")
                            await asyncio.sleep(e.seconds)
                        except Exception as e:
                            logging.error(f"Ошибка отправки в чат {chat_id}: {e}")
            except Exception as e:
                logging.error(f"Ошибка клиента для {acc['phone']}: {e}")
            finally:
                await client.disconnect()
    except Exception as e:
        logging.error(f"Ошибка в задаче для {user_id}: {e}")

# ---------- ПЛАНИРОВЩИК ----------
scheduler = AsyncIOScheduler()

async def start_scheduler_for_user(user_id: int):
    job_id = await get_job_id(user_id)
    if job_id:
        try:
            scheduler.get_job(job_id)
            return
        except JobLookupError:
            await delete_job_id(user_id)

    settings = await get_user_settings(user_id)
    interval = settings['interval_seconds']
    job = scheduler.add_job(
        send_messages_for_user,
        'interval',
        seconds=interval,
        args=[user_id],
        id=f"mailing_{user_id}",
        replace_existing=True
    )
    await save_job_id(user_id, job.id)

async def stop_scheduler_for_user(user_id: int):
    job_id = await get_job_id(user_id)
    if job_id:
        try:
            scheduler.remove_job(job_id)
        except JobLookupError:
            pass
        await delete_job_id(user_id)

async def restore_schedulers_on_startup():
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT user_id FROM scheduler_jobs")
        rows = await cursor.fetchall()
    for row in rows:
        user_id = row[0]
        await start_scheduler_for_user(user_id)

# ---------- ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ РУЧНОГО ДОБАВЛЕНИЯ ----------
async def join_and_add_chat(account_id: int, user_id: int, chat_input: str):
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        return False, "Аккаунт не найден."

    client = TelegramClient(StringSession(acc['session_string']), API_ID, API_HASH)
    try:
        await client.start()
        try:
            entity = await client.get_entity(chat_input)
        except Exception:
            if 'joinchat' in chat_input or 't.me/joinchat' in chat_input or 't.me/+' in chat_input:
                try:
                    entity = await client.join_chat(chat_input)
                except Exception as e2:
                    return False, f"Не удалось вступить по ссылке: {e2}"
            else:
                return False, f"Чат не найден. Попробуйте ID или ссылку."

        try:
            await client.join_channel(entity)
        except Exception:
            pass

        chat_id = entity.id
        title = getattr(entity, 'title', None) or str(chat_id)
        chats = acc['chats']
        if not any(c['id'] == chat_id for c in chats):
            chats.append({"id": chat_id, "title": title})
            await update_account_chats(account_id, user_id, chats)
            return True, f"✅ Чат '{title}' добавлен (ID: {chat_id})."
        else:
            return False, "Этот чат уже есть в списке."
    except Exception as e:
        return False, f"Ошибка: {e}"
    finally:
        await client.disconnect()

# ---------- ФИЛЬТРЫ И ПОИСК ----------
async def is_chat_active(client, entity, days: int):
    try:
        msgs = await client.get_messages(entity, limit=1)
        if not msgs:
            return False
        last = msgs[0]
        if not last.date:
            return False
        delta = (datetime.utcnow() - last.date.replace(tzinfo=None)).days
        return delta <= days
    except Exception:
        return False


async def search_and_join_chats(client, account_id, user_id, keywords,
                                min_participants, max_chats, activity_days):
    """Ищет чаты, вступает, фильтрует по настраиваемым параметрам."""
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        return [], "Аккаунт не найден."
    existing = acc['chats']
    existing_ids = {c['id'] for c in existing}
    free_slots = max_chats - len(existing)
    if free_slots <= 0:
        return [], f"У аккаунта уже {max_chats} чатов (лимит)."

    added = []
    seen = set()
    try:
        for kw in keywords:
            if len(added) >= free_slots:
                break
            try:
                result = await client(functions.contacts.SearchRequest(q=kw, limit=50))
            except Exception as e:
                logging.error(f"Search error [{kw}]: {e}")
                continue

            for chat in result.chats:
                if len(added) >= free_slots:
                    break
                if not isinstance(chat, (tl_types.Channel, tl_types.Chat)):
                    continue
                if not getattr(chat, 'username', None):
                    continue
                if chat.id in existing_ids or chat.id in seen:
                    continue
                seen.add(chat.id)

                participants = getattr(chat, 'participants_count', 0) or 0
                if participants < min_participants:
                    continue

                try:
                    entity = await client.get_entity(chat.username)
                    try:
                        await client.join_channel(entity)
                    except Exception:
                        pass
                    if not await is_chat_active(client, entity, activity_days):
                        try:
                            await client.delete_dialog(entity)
                        except Exception:
                            pass
                        continue
                    title = getattr(entity, 'title', None) or chat.username
                    existing.append({"id": entity.id, "title": title})
                    added.append({"id": entity.id, "title": title})
                    await update_account_chats(account_id, user_id, existing)
                except FloodWaitError as e:
                    logging.warning(f"FloodWait {e.seconds}s")
                    await asyncio.sleep(e.seconds)
                except Exception as e:
                    logging.error(f"Join error @{chat.username}: {e}")
                    continue
    except Exception as e:
        logging.error(f"search_and_join_chats error: {e}")

    return added, None

# ---------- ОБРАБОТЧИКИ ----------
dp = Dispatcher(storage=MemoryStorage())

@dp.message(F.text == "/start")
async def cmd_start(message: types.Message):
    await message.answer("Привет! Бот для рассылки.", reply_markup=main_keyboard())

# ---------- АККАУНТЫ ----------
@dp.message(F.text == "📋 Аккаунты")
async def show_accounts(message: types.Message):
    user_id = message.from_user.id
    settings = await get_user_settings(user_id)
    accounts = await get_accounts(user_id)
    if not accounts:
        kb = ReplyKeyboardMarkup(
            keyboard=[[KeyboardButton(text="➕ Добавить аккаунт")],
                      [KeyboardButton(text="🔙 Назад")]],
            resize_keyboard=True
        )
        await message.answer("Нет аккаунтов.", reply_markup=kb)
    else:
        await message.answer("Ваши аккаунты:", reply_markup=accounts_keyboard(accounts, settings['max_chats']))

@dp.message(F.text == "➕ Добавить аккаунт")
async def add_account_start(message: types.Message, state: FSMContext):
    await message.answer("Введите номер телефона в формате +79123456789:")
    await state.set_state(AddAccountStates.waiting_phone)

@dp.message(AddAccountStates.waiting_phone)
async def add_account_phone(message: types.Message, state: FSMContext):
    phone = message.text.strip()
    if not phone.startswith('+'):
        await message.answer("Номер должен начинаться с +.")
        return
    await state.update_data(phone=phone)
    client = TelegramClient(StringSession(), API_ID, API_HASH)
    await state.update_data(client=client)
    try:
        await client.connect()
        await client.send_code_request(phone)
        await message.answer("Код отправлен. Введите его:")
        await state.set_state(AddAccountStates.waiting_code)
    except Exception as e:
        await message.answer(f"Ошибка: {e}")
        await state.clear()
        await client.disconnect()

@dp.message(AddAccountStates.waiting_code)
async def add_account_code(message: types.Message, state: FSMContext):
    code = message.text.strip()
    data = await state.get_data()
    client = data.get('client')
    phone = data.get('phone')
    if not client:
        await message.answer("Сессия потеряна.")
        await state.clear()
        return
    try:
        await client.sign_in(phone, code)
        session_string = client.session.save()
        me = await client.get_me()
        username = me.username if me.username else None
        await add_account(message.from_user.id, phone, username, session_string)
        await message.answer("Аккаунт добавлен!")
        settings = await get_user_settings(message.from_user.id)
        accounts = await get_accounts(message.from_user.id)
        await message.answer("Ваши аккаунты:", reply_markup=accounts_keyboard(accounts, settings['max_chats']))
    except SessionPasswordNeededError:
        await message.answer("Введите пароль двухфакторной аутентификации:")
        await state.set_state(AddAccountStates.waiting_password)
        return
    except Exception as e:
        await message.answer(f"Ошибка: {e}")
    await client.disconnect()
    await state.clear()

@dp.message(AddAccountStates.waiting_password)
async def add_account_password(message: types.Message, state: FSMContext):
    password = message.text.strip()
    data = await state.get_data()
    client = data.get('client')
    phone = data.get('phone')
    if not client:
        await message.answer("Сессия потеряна.")
        await state.clear()
        return
    try:
        await client.sign_in(password=password)
        session_string = client.session.save()
        me = await client.get_me()
        username = me.username if me.username else None
        await add_account(message.from_user.id, phone, username, session_string)
        await message.answer("Аккаунт добавлен!")
        settings = await get_user_settings(message.from_user.id)
        accounts = await get_accounts(message.from_user.id)
        await message.answer("Ваши аккаунты:", reply_markup=accounts_keyboard(accounts, settings['max_chats']))
    except Exception as e:
        await message.answer(f"Ошибка: {e}")
    await client.disconnect()
    await state.clear()

# ---------- ДЕТАЛИ АККАУНТА ----------
@dp.message(F.text.startswith("✅") or F.text.startswith("❌"))
async def account_detail(message: types.Message):
    parts = message.text.split(" • ")
    if len(parts) < 3:
        await message.answer("Не удалось распознать аккаунт.")
        return
    phone = parts[1].strip()
    accounts = await get_accounts(message.from_user.id)
    acc = next((a for a in accounts if a['phone'] == phone), None)
    if not acc:
        await message.answer("Аккаунт не найден.")
        return
    settings = await get_user_settings(message.from_user.id)
    text = (f"📱 Аккаунт: @{acc['username'] if acc['username'] else 'без ника'}\n"
            f"📞 Номер: {acc['phone']}\n"
            f"📊 Отправлено: {acc['sent_count']}\n"
            f"Статус: {'✅ Включён' if acc['is_active'] else '❌ Выключен'}\n"
            f"Чаты: {len(acc['chats'])}/{settings['max_chats']}")
    await message.answer(text, reply_markup=account_detail_keyboard(acc['id']))

# ---------- ИНЛАЙН-КНОПКИ ДЕТАЛЕЙ ----------
@dp.callback_query(F.data.startswith("acc_toggle_"))
async def toggle_account_callback(callback: types.CallbackQuery):
    account_id = int(callback.data.split("_")[2])
    user_id = callback.from_user.id
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        await callback.answer("Аккаунт не найден.", show_alert=True)
        return
    new_active = not acc['is_active']
    await toggle_account_active(account_id, user_id, new_active)
    await callback.answer(f"Аккаунт {'включён' if new_active else 'выключен'}")
    acc = await get_account_by_id(account_id, user_id)
    settings = await get_user_settings(user_id)
    text = (f"📱 Аккаунт: @{acc['username'] if acc['username'] else 'без ника'}\n"
            f"📞 Номер: {acc['phone']}\n"
            f"📊 Отправлено: {acc['sent_count']}\n"
            f"Статус: {'✅ Включён' if acc['is_active'] else '❌ Выключен'}\n"
            f"Чаты: {len(acc['chats'])}/{settings['max_chats']}")
    await callback.message.edit_text(text, reply_markup=account_detail_keyboard(acc['id']))

