@dp.message(S_set.inv_limit)
async def set_inv_limit_save(m: types.Message, st: FSMContext):
    try:
        v = int(m.text.strip())
        if v < 1 or v > 1000:
            raise ValueError
        await set_setting(m.from_user.id, "invite_limit", v)
        await m.answer(f"✅ {v}")
    except ValueError:
        await m.answer("Число 1–1000.")
    await st.clear()


