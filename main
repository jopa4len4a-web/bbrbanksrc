# ---------- ПРОФИЛЬ ----------
@dp.callback_query(F.data.startswith("acc_prof_"))
async def prof_show(cb: types.CallbackQuery):
    acc_id = int(cb.data.split("_")[2])
    acc = await get_account(acc_id, cb.from_user.id)
    if not acc:
        await cb.answer("Не найден.", show_alert=True)
        return
    info = "✏️ Профиль\n\n"
    client = make_client(acc["session_string"])
    try:
        await client.start()
        me = await client.get_me()
        info += (f"👤 Имя: {me.first_name or '—'}\n📛 Фамилия: {me.last_name or '—'}\n"
                 f"🔗 Юзернейм: @{me.username if me.username else '—'}\n"
                 f"📞 Телефон: {me.phone or acc['phone']}")
    except Exception as e:
        info += f"Ошибка: {e}"
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    try:
        await cb.message.edit_text(info, reply_markup=profile_menu(acc_id))
    except TelegramBadRequest:
        pass
    await cb.answer()


@dp.callback_query(F.data.startswith("prof_first_"))
async def prof_first_start(cb: types.CallbackQuery, st: FSMContext):
    acc_id = int(cb.data.split("_")[2])
    await st.update_data(acc_id=acc_id)
    await cb.message.answer("Введи имя:")
    await st.set_state(S_prof.first)
    await cb.answer()


@dp.message(S_prof.first)
async def prof_first_apply(m: types.Message, st: FSMContext):
    name = m.text.strip()
    if not name or len(name) > 64:
        await m.answer("1–64 символа.")
        return
    data = await st.get_data()
    acc = await get_account(data["acc_id"], m.from_user.id)
    client = make_client(acc["session_string"])
    try:
        await client.start()
        me = await client.get_me()
        await client(UpdateProfileRequest(first_name=name, last_name=me.last_name if me.last_name else None))
        await m.answer(f"✅ Имя: {name}")
    except FloodWaitError as e:
        await m.answer(f"Подожди {e.seconds} сек.")
    except Exception as e:
        await m.answer(f"❌ {e}")
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    await st.clear()


