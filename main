@dp.message(PartnershipStates.waiting_username)
async def partnership_username_input(message: types.Message, state: FSMContext):
    target_username = message.text.strip().lstrip('@')
    if not target_username:
        await message.answer("Введите @username.")
        return
    user_id = message.from_user.id
    target_user_id = await find_user_by_username(target_username)
    if not target_user_id:
        await message.answer(f"❌ @{target_username} не найден. Он должен нажать /start в боте.")
        await state.clear(); return
    if target_user_id == user_id:
        await message.answer("❌ Нельзя стать партнёром самого себя.")
        await state.clear(); return
    existing = await get_partner_id(target_user_id)
    if existing and existing != user_id:
        await message.answer(f"❌ У @{target_username} уже есть партнёр.")
        await state.clear(); return
    await set_partner(user_id, target_user_id)
    await message.answer(f"✅ Партнёрство с @{target_username} установлено!")
    try:
        await message.bot.send_message(
            target_user_id,
            f"🤝 @{message.from_user.username or user_id} установил с вами партнёрство аккаунтов."
        )
    except Exception:
        pass
    # Копируем все существующие аккаунты друг другу
    my_accounts = await get_accounts(user_id)
    copied = 0
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT phone FROM accounts WHERE user_id = ?", (target_user_id,))
        target_phones = {r[0] for r in await cursor.fetchall()}
        for acc in my_accounts:
            if acc['phone'] in target_phones:
                continue
            await db.execute(
                "INSERT INTO accounts (user_id, phone, username, session_string, chats) VALUES (?, ?, ?, ?, ?)",
                (target_user_id, acc['phone'], acc['username'], acc['session_string'], json.dumps(acc['chats']))
            )
            copied += 1
        cursor = await db.execute("SELECT phone FROM accounts WHERE user_id = ?", (user_id,))
        my_phones = {r[0] for r in await cursor.fetchall()}
        partner_accounts = await get_accounts(target_user_id)
        for acc in partner_accounts:
            if acc['phone'] in my_phones:
                continue
            await db.execute(
                "INSERT INTO accounts (user_id, phone, username, session_string, chats) VALUES (?, ?, ?, ?, ?)",
                (user_id, acc['phone'], acc['username'], acc['session_string'], json.dumps(acc['chats']))
            )
            copied += 1
        await db.commit()
    if copied:
        await message.answer(f"📤 Синхронизировано аккаунтов: {copied}.")
    await state.clear()

