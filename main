# ---------- INLINE АККАУНТА ----------
@dp.callback_query(F.data.startswith("acc_toggle_"))
async def acc_toggle(cb: types.CallbackQuery):
    acc_id = int(cb.data.split("_")[2])
    acc = await get_account(acc_id, cb.from_user.id)
    if not acc:
        await cb.answer("Не найден.", show_alert=True)
        return
    await toggle_acc(acc_id, cb.from_user.id, not acc["is_active"])
    acc = await get_account(acc_id, cb.from_user.id)
    await cb.answer("Обновлено")
    text = (f"📱 @{acc['username'] or 'без ника'}\n📞 {acc['phone']}\n"
            f"✉️ Чатов рассылки: {len(acc['chats'])}\n"
            f"📥 Источников: {len(acc['sources'])}\n"
            f"📤 Цель: {acc['target'].get('title') if acc['target'] else '—'}\n"
            f"📊 Спарсено: {acc['parsed_count']} | 📨 Инвайтов: {acc['invited_count']} | ✉️ Отправлено: {acc['sent_count']}")
    try:
        await cb.message.edit_text(text, reply_markup=account_menu_inline(acc_id, acc["is_active"]))
    except TelegramBadRequest:
        pass


@dp.callback_query(F.data.startswith("acc_del_"))
async def acc_del(cb: types.CallbackQuery):
    acc_id = int(cb.data.split("_")[2])
    await del_account(acc_id, cb.from_user.id)
    await cb.answer("Удалён")
    accounts = await get_accounts(cb.from_user.id)
    try:
        await cb.message.edit_text("Твои аккаунты:", reply_markup=accounts_menu_reply(accounts))
    except TelegramBadRequest:
        pass


@dp.callback_query(F.data.startswith("acc_back_"))
async def acc_back(cb: types.CallbackQuery):
    acc_id = int(cb.data.split("_")[2])
    acc = await get_account(acc_id, cb.from_user.id)
    if not acc:
        await cb.answer("Не найден.", show_alert=True)
        return
    text = (f"📱 @{acc['username'] or 'без ника'}\n📞 {acc['phone']}\n"
            f"✉️ Чатов рассылки: {len(acc['chats'])}\n"
            f"📥 Источников: {len(acc['sources'])}\n"
            f"📤 Цель: {acc['target'].get('title') if acc['target'] else '—'}\n"
            f"📊 Спарсено: {acc['parsed_count']} | 📨 Инвайтов: {acc['invited_count']} | ✉️ Отправлено: {acc['sent_count']}")
    try:
        await cb.message.edit_text(text, reply_markup=account_menu_inline(acc_id, acc["is_active"]))
    except TelegramBadRequest:
        pass
    await cb.answer()


# ---------- ЧАТЫ РАССЫЛКИ ----------
@dp.callback_query(F.data.startswith("acc_chats_"))
async def acc_chats(cb: types.CallbackQuery):
    acc_id = int(cb.data.split("_")[2])
    acc = await get_account(acc_id, cb.from_user.id)
    if not acc:
        await cb.answer("Не найден.", show_alert=True)
        return
    text = "✉️ Чаты рассылки:\n" + ("\n".join(f"{i+1}. {c.get('title')}" for i, c in enumerate(acc["chats"]))
                                    if acc["chats"] else "Пусто.")
    try:
        await cb.message.edit_text(text, reply_markup=chats_menu(acc_id, acc["chats"]))
    except TelegramBadRequest:
        pass
    await cb.answer()


@dp.callback_query(F.data.startswith("chat_pick_"))
async def chat_pick(cb: types.CallbackQuery, st: FSMContext):
    acc_id = int(cb.data.split("_")[2])
    acc = await get_account(acc_id, cb.from_user.id)
    if not acc:
        await cb.answer("Не найден.", show_alert=True)
        return
    await cb.answer("Загружаю...")
    dialogs = await get_dialogs(acc)
    if not dialogs:
        await cb.message.answer("Нет чатов.")
        return
    await st.update_data(dialogs=dialogs)
    try:
        await cb.message.edit_text("Выбери чат:", reply_markup=picker_menu(acc_id, dialogs, "chat"))
    except TelegramBadRequest:
        pass


@dp.callback_query(F.data.startswith("chat_add_"))
async def chat_add(cb: types.CallbackQuery, st: FSMContext):
    parts = cb.data.split("_")
    acc_id = int(parts[2])
    idx = int(parts[3])
    data = await st.get_data()
    dialogs = data.get("dialogs", [])
    if not (0 <= idx < len(dialogs)):
        await cb.answer("Ошибка.", show_alert=True)
        return
    acc = await get_account(acc_id, cb.from_user.id)
    new = dialogs[idx]
    chats = acc["chats"]
    if not any(c["id"] == new["id"] for c in chats):
        chats.append(new)
        await save_chats(acc_id, cb.from_user.id, chats)
    await cb.answer(f"+ {new['title']}")
    text = "✉️ Чаты рассылки:\n" + "\n".join(f"{i+1}. {c.get('title')}" for i, c in enumerate(chats))
    try:
        await cb.message.edit_text(text, reply_markup=chats_menu(acc_id, chats))
    except TelegramBadRequest:
        pass


@dp.callback_query(F.data.startswith("chat_del_"))
async def chat_del(cb: types.CallbackQuery):
    parts = cb.data.split("_")
    acc_id = int(parts[2])
    idx = int(parts[3])
    acc = await get_account(acc_id, cb.from_user.id)
    if not acc:
        await cb.answer("Не найден.", show_alert=True)
        return
    chats = acc["chats"]
    if 0 <= idx < len(chats):
        chats.pop(idx)
        await save_chats(acc_id, cb.from_user.id, chats)
    await cb.answer("Удалено")
    text = "✉️ Чаты рассылки:\n" + ("\n".join(f"{i+1}. {c.get('title')}" for i, c in enumerate(chats))
                                    if chats else "Пусто.")
    try:
        await cb.message.edit_text(text, reply_markup=chats_menu(acc_id, chats))
    except TelegramBadRequest:
        pass


