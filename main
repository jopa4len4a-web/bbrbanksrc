def main_keyboard():
    return ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="📋 Аккаунты")],
            [KeyboardButton(text="🔍 Поиск чатов")],
            [KeyboardButton(text="⚙️ Настройки")],
            [KeyboardButton(text="▶️ Запустить рассылку")]
        ],
        resize_keyboard=True
    )

def accounts_keyboard(accounts, max_chats=25):
    kb = []
    for acc in accounts:
        status = "✅" if acc['is_active'] else "❌"
        username = acc['username'] if acc['username'] else "без ника"
        display = f"{status} @{username} • {acc['phone']} • {len(acc['chats'])}/{max_chats}"
        kb.append([KeyboardButton(text=display)])
    kb.append([KeyboardButton(text="➕ Добавить аккаунт")])
    kb.append([KeyboardButton(text="🔙 Назад")])
    return ReplyKeyboardMarkup(keyboard=kb, resize_keyboard=True)

