@dp.callback_query(F.data == "invite_noop")
async def invite_noop(callback: types.CallbackQuery):
    await callback.answer("Это информация")


@dp.callback_query(F.data.startswith("invite_"))
async def invite_start(callback: types.CallbackQuery):
    data = callback.data.split("_")[1]
    if data == "all":
        limit = 0
    else:
        try:
            limit = int(data)
        except ValueError:
            await callback.answer("Ошибка.", show_alert=True)
            return
    await callback.answer(f"Запускаю: {data}")

    msg = await callback.message.answer(f"▶️ Инвайт запущен ({data}). Жди отчёт...")
    report = await invite_only(callback.from_user.id, limit)

    if not report:
        await msg.edit_text("❌ Инвайт уже запущен.")
        return

    if report.get("error") and report["invited"] == 0:
        await msg.edit_text(f"❌ Ошибка: {report['error']}")
        return

    lines = [
        f"✅ Инвайт завершён.",
        f"",
        f"📊 Всего в обработке: {report.get('total', 0)}",
        f"✅ Добавлено: {report['invited']}",
    ]
    if report.get("skipped"):
        lines.append(f"⏭ Пропущено: {sum(report['skipped'].values())}")
    if report.get("failed"):
        lines.append(f"❌ Ошибок: {sum(report['failed'].values())}")
    if report.get("skipped"):
        lines.append("")
        lines.append("⏭ Пропущены по причинам:")
        for reason, count in sorted(report["skipped"].items(), key=lambda x: -x[1]):
            lines.append(f"• {reason_to_ru(reason)}: {count}")
    if report.get("failed"):
        lines.append("")
        lines.append("❌ Ошибки:")
        for reason, count in sorted(report["failed"].items(), key=lambda x: -x[1]):
            lines.append(f"• {reason_to_ru(reason)}: {count}")

    await msg.edit_text("\n".join(lines))


# ---------- ОШИБКИ ----------
@dp.message(F.text == "❌ Ошибки")
async def show_errors(message: types.Message):
    await ensure_user(message.from_user.id, message.from_user.username)
    errs = await error_stats(message.from_user.id)
    if not errs:
        await message.answer("✅ Ошибок нет.")
        return
    total = sum(c for _, c in errs)
    lines = [f"❌ Ошибки инвайта (всего: {total}):", ""]
    for reason, count in errs:
        lines.append(f"• {reason_to_ru(reason)} — {count}")
    lines.append("")
    lines.append("🧹 Очистить ошибки: /clear_errors")
    await message.answer("\n".join(lines))


@dp.message(Command("clear_errors"))
async def clear_errors(message: types.Message):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM queue WHERE user_id = ? AND status = 'failed'", (message.from_user.id,))
        await db.commit()
    await message.answer("🧹 Ошибки очищены.")


# ---------- НАСТРОЙКИ ----------
@dp.message(F.text == "⚙️ Настройки")
async def open_settings(message: types.Message):
    await ensure_user(message.from_user.id, message.from_user.username)
    await message.answer("⚙️ Настройки:", reply_markup=InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="✉️ Рассылка", callback_data="mail_open")],
        [InlineKeyboardButton(text="🔍 Парсинг", callback_data="parse_open")],
    ]))


@dp.callback_query(F.data == "parse_open")
async def parse_open(callback: types.CallbackQuery):
    running = await is_parsing_running(callback.from_user.id)
    try:
        await callback.message.edit_text("🔍 Парсинг источников:", reply_markup=parsing_menu(running))
    except TelegramBadRequest:
        pass
    await callback.answer()


@dp.callback_query(F.data == "set_interval")
async def set_interval_open(callback: types.CallbackQuery):
    await callback.message.edit_text("Выбери интервал рассылки:", reply_markup=interval_menu())
    await callback.answer()


@dp.callback_query(F.data.startswith("int_"))
async def set_interval_value(callback: types.CallbackQuery):
    v = int(callback.data.split("_")[1])
    await set_setting(callback.from_user.id, "interval", v)
    await callback.answer(f"{v} сек")
    running = await is_mailing_running(callback.from_user.id)
    try:
        await callback.message.edit_text("✉️ Рассылка:", reply_markup=mailing_menu(running))
    except TelegramBadRequest:
        pass


@dp.callback_query(F.data == "set_delay")
async def set_delay_open(callback: types.CallbackQuery, state: FSMContext):
    await callback.message.answer("Введи задержку инвайтов (сек), например 0.5:")
    await state.set_state(SettingsStates.waiting_delay)
    await callback.answer()


@dp.message(SettingsStates.waiting_delay)
async def set_delay_save(message: types.Message, state: FSMContext):
    try:
        v = float(message.text.strip().replace(",", "."))
        if v < 0 or v > 60:
            raise ValueError
        await set_setting(message.from_user.id, "delay", v)
        await message.answer(f"✅ {v} сек")
    except ValueError:
        await message.answer("Число 0–60.")
    await state.clear()


@dp.callback_query(F.data == "back_main")
async def back_main(callback: types.CallbackQuery):
    await callback.message.delete()
    await callback.message.answer("Главное меню:", reply_markup=main_menu())
    await callback.answer()


@dp.message(F.text == "🔙 Назад")
async def back_to_menu(message: types.Message):
    await message.answer("Главное меню:", reply_markup=main_menu())


@dp.message()
async def fallback(message: types.Message):
    pass


async def main():
    logging.info("=== BOT STARTING ===")
    await init_db()
    if not scheduler.running:
        scheduler.start()
    await restore_jobs()
    bot = Bot(token=BOT_TOKEN)
    try:
        await bot.delete_webhook(drop_pending_updates=True)
    except Exception as e:
        logging.warning(f"delete_webhook: {e}")
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
