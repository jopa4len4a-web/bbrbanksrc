@dp.message(F.text == "✉️ Рассылка")
async def open_mailing(message: types.Message):
    await ensure_user(message.from_user.id, message.from_user.username)
    running = await is_mailing_running(message.from_user.id)
    await message.answer("✉️ Рассылка:", reply_markup=mailing_menu(running))


@dp.callback_query(F.data == "mail_toggle")
async def mail_toggle(callback: types.CallbackQuery):
    uid = callback.from_user.id
    running = await is_mailing_running(uid)
    if running:
        await stop_mailing(uid)
        await callback.answer("Остановлено")
    else:
        accs = [a for a in await get_accounts(uid) if a["is_active"] and a["chats"]]
        if not accs:
            await callback.answer("Нет активных аккаунтов с чатами.", show_alert=True)
            return
        msgs = await get_messages(uid)
        if not msgs:
            await callback.answer("Нет текстов.", show_alert=True)
            return
        await start_mailing(uid)
        await callback.answer("Запущено")
    running = await is_mailing_running(uid)
    try:
        await callback.message.edit_reply_markup(reply_markup=mailing_menu(running))
    except TelegramBadRequest:
        pass


@dp.callback_query(F.data == "mail_open")
async def mail_open(callback: types.CallbackQuery):
    running = await is_mailing_running(callback.from_user.id)
    try:
        await callback.message.edit_text("✉️ Рассылка:", reply_markup=mailing_menu(running))
    except TelegramBadRequest:
        pass
    await callback.answer()


