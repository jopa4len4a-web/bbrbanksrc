dp = Dispatcher(storage=MemoryStorage())

@dp.message(F.text == "/start")
async def cmd_start(message: types.Message):
    await message.answer("Привет! Бот для рассылки.", reply_markup=main_keyboard())

# ---------- АККАУНТЫ ----------
@dp.message(F.text == "📋 Аккаунты")
async def show_accounts(message: types.Message):
    user_id = message.from_user.id
    settings = await get_user_settings(user_id)
    accounts = await get_accounts(user_id)
    if not accounts:
        kb = ReplyKeyboardMarkup(
            keyboard=[[KeyboardButton(text="➕ Добавить аккаунт")],
                      [KeyboardButton(text="🔙 Назад")]],
            resize_keyboard=True
        )
        await message.answer("Нет аккаунтов.", reply_markup=kb)
    else:
        await message.answer("Ваши аккаунты:", reply_markup=accounts_keyboard(accounts, settings['max_chats']))

@dp.message(F.text == "➕ Добавить аккаунт")
async def add_account_start(message: types.Message, state: FSMContext):
    await message.answer("Введите номер телефона в формате +79123456789:")
    await state.set_state(AddAccountStates.waiting_phone)

@dp.message(AddAccountStates.waiting_phone)
async def add_account_phone(message: types.Message, state: FSMContext):
    phone = message.text.strip()
    if not phone.startswith('+'):
        await message.answer("Номер должен начинаться с +.")
        return
    await state.update_data(phone=phone)
    client = TelegramClient(StringSession(), API_ID, API_HASH)
    await state.update_data(client=client)
    try:
        await client.connect()
        await client.send_code_request(phone)
        await message.answer("Код отправлен. Введите его:")
        await state.set_state(AddAccountStates.waiting_code)
    except Exception as e:
        await message.answer(f"Ошибка: {e}")
        await state.clear()
        await client.disconnect()

@dp.message(AddAccountStates.waiting_code)
async def add_account_code(message: types.Message, state: FSMContext):
    code = message.text.strip()
    data = await state.get_data()
    client = data.get('client')
    phone = data.get('phone')
    if not client:
        await message.answer("Сессия потеряна.")
        await state.clear()
        return
    try:
        await client.sign_in(phone, code)
        session_string = client.session.save()
        me = await client.get_me()
        username = me.username if me.username else None
        await add_account(message.from_user.id, phone, username, session_string)
        await message.answer("Аккаунт добавлен!")
        settings = await get_user_settings(message.from_user.id)
        accounts = await get_accounts(message.from_user.id)
        await message.answer("Ваши аккаунты:", reply_markup=accounts_keyboard(accounts, settings['max_chats']))
    except SessionPasswordNeededError:
        await message.answer("Введите пароль двухфакторной аутентификации:")
        await state.set_state(AddAccountStates.waiting_password)
        return
    except Exception as e:
        await message.answer(f"Ошибка: {e}")
    await client.disconnect()
    await state.clear()

@dp.message(AddAccountStates.waiting_password)
async def add_account_password(message: types.Message, state: FSMContext):
    password = message.text.strip()
    data = await state.get_data()
    client = data.get('client')
    phone = data.get('phone')
    if not client:
        await message.answer("Сессия потеряна.")
        await state.clear()
        return
    try:
        await client.sign_in(password=password)
        session_string = client.session.save()
        me = await client.get_me()
        username = me.username if me.username else None
        await add_account(message.from_user.id, phone, username, session_string)
        await message.answer("Аккаунт добавлен!")
        settings = await get_user_settings(message.from_user.id)
        accounts = await get_accounts(message.from_user.id)
        await message.answer("Ваши аккаунты:", reply_markup=accounts_keyboard(accounts, settings['max_chats']))
    except Exception as e:
        await message.answer(f"Ошибка: {e}")
    await client.disconnect()
    await state.clear()

# ---------- ДЕТАЛИ АККАУНТА ----------
@dp.message(F.text.startswith("✅") or F.text.startswith("❌"))
async def account_detail(message: types.Message):
    parts = message.text.split(" • ")
    if len(parts) < 3:
        await message.answer("Не удалось распознать аккаунт.")
        return
    phone = parts[1].strip()
    accounts = await get_accounts(message.from_user.id)
    acc = next((a for a in accounts if a['phone'] == phone), None)
    if not acc:
        await message.answer("Аккаунт не найден.")
        return
    settings = await get_user_settings(message.from_user.id)
    text = (f"📱 Аккаунт: @{acc['username'] if acc['username'] else 'без ника'}\n"
            f"📞 Номер: {acc['phone']}\n"
            f"📊 Отправлено: {acc['sent_count']}\n"
            f"Статус: {'✅ Включён' if acc['is_active'] else '❌ Выключен'}\n"
            f"Чаты: {len(acc['chats'])}/{settings['max_chats']}")
    await message.answer(text, reply_markup=account_detail_keyboard(acc['id']))

@dp.callback_query(F.data.startswith("acc_toggle_"))
async def toggle_account_callback(callback: types.CallbackQuery):
    account_id = int(callback.data.split("_")[2])
    user_id = callback.from_user.id
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        await callback.answer("Аккаунт не найден.", show_alert=True)
        return
    new_active = not acc['is_active']
    await toggle_account_active(account_id, user_id, new_active)
    await callback.answer(f"Аккаунт {'включён' if new_active else 'выключен'}")
    acc = await get_account_by_id(account_id, user_id)
    settings = await get_user_settings(user_id)
    text = (f"📱 Аккаунт: @{acc['username'] if acc['username'] else 'без ника'}\n"
            f"📞 Номер: {acc['phone']}\n"
            f"📊 Отправлено: {acc['sent_count']}\n"
            f"Статус: {'✅ Включён' if acc['is_active'] else '❌ Выключен'}\n"
            f"Чаты: {len(acc['chats'])}/{settings['max_chats']}")
    await callback.message.edit_text(text, reply_markup=account_detail_keyboard(acc['id']))

@dp.callback_query(F.data.startswith("acc_chats_"))
async def account_chats(callback: types.CallbackQuery):
    account_id = int(callback.data.split("_")[2])
    user_id = callback.from_user.id
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        await callback.answer("Аккаунт не найден.", show_alert=True)
        return
    settings = await get_user_settings(user_id)
    chats = acc['chats']
    if not chats:
        text = "У этого аккаунта нет чатов."
    else:
        text = f"Чаты ({len(chats)}/{settings['max_chats']}):\n" + "\n".join(
            [f"{i+1}. {chat.get('title', chat['id'])}" for i, chat in enumerate(chats)]
        )
    await callback.message.edit_text(text, reply_markup=chats_inline_keyboard(account_id, chats))
    await callback.answer()

@dp.callback_query(F.data.startswith("acc_back_"))
async def back_to_account_detail(callback: types.CallbackQuery):
    account_id = int(callback.data.split("_")[2])
    user_id = callback.from_user.id
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        await callback.answer("Аккаунт не найден.", show_alert=True)
        return
    settings = await get_user_settings(user_id)
    text = (f"📱 Аккаунт: @{acc['username'] if acc['username'] else 'без ника'}\n"
            f"📞 Номер: {acc['phone']}\n"
            f"📊 Отправлено: {acc['sent_count']}\n"
            f"Статус: {'✅ Включён' if acc['is_active'] else '❌ Выключен'}\n"
            f"Чаты: {len(acc['chats'])}/{settings['max_chats']}")
    try:
        await callback.message.edit_text(text, reply_markup=account_detail_keyboard(acc['id']))
    except TelegramBadRequest:
        pass
    await callback.answer()

@dp.callback_query(F.data == "back_to_accounts")
async def back_to_accounts_list(callback: types.CallbackQuery):
    user_id = callback.from_user.id
    settings = await get_user_settings(user_id)
    accounts = await get_accounts(user_id)
    if not accounts:
        kb = ReplyKeyboardMarkup(
            keyboard=[[KeyboardButton(text="➕ Добавить аккаунт")],
                      [KeyboardButton(text="🔙 Назад")]],
            resize_keyboard=True
        )
        await callback.message.delete()
        await callback.message.answer("Нет аккаунтов.", reply_markup=kb)
    else:
        await callback.message.delete()
        await callback.message.answer("Ваши аккаунты:", reply_markup=accounts_keyboard(accounts, settings['max_chats']))
    await callback.answer()

# ---------- РУЧНОЕ ДОБАВЛЕНИЕ ЧАТА ----------
@dp.callback_query(F.data.startswith("acc_add_chat_"))
async def add_chat_start(callback: types.CallbackQuery, state: FSMContext):
    account_id = int(callback.data.split("_")[3])
    await state.update_data(account_id=account_id)
    await callback.message.answer("Введите ссылку (t.me/...) или юзернейм (@chat):")
    await state.set_state(AddChatStates.waiting_chat_input)
    await callback.answer()

@dp.message(AddChatStates.waiting_chat_input)
async def add_chat_save(message: types.Message, state: FSMContext):
    chat_input = message.text.strip()
    data = await state.get_data()
    account_id = data.get('account_id')
    user_id = message.from_user.id
    success, msg = await join_and_add_chat(account_id, user_id, chat_input)
    await message.answer(msg)
    await state.clear()
    acc = await get_account_by_id(account_id, user_id)
    settings = await get_user_settings(user_id)
    chats = acc['chats']
    if not chats:
        text = "У этого аккаунта нет чатов."
    else:
        text = f"Чаты ({len(chats)}/{settings['max_chats']}):\n" + "\n".join(
            [f"{i+1}. {chat.get('title', chat['id'])}" for i, chat in enumerate(chats)]
        )
    await message.answer(text, reply_markup=chats_inline_keyboard(account_id, chats))

@dp.callback_query(F.data.startswith("acc_del_chat_"))
async def delete_chat_from_account(callback: types.CallbackQuery):
    parts = callback.data.split("_")
    account_id = int(parts[3])
    index = int(parts[4])
    user_id = callback.from_user.id
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        await callback.answer("Аккаунт не найден.", show_alert=True)
        return
    settings = await get_user_settings(user_id)
    chats = acc['chats']
    if 0 <= index < len(chats):
        deleted = chats.pop(index)
        await update_account_chats(account_id, user_id, chats)
        await callback.answer(f"Чат '{deleted.get('title', deleted['id'])}' удалён.")
        if not chats:
            text = "У этого аккаунта нет чатов."
        else:
            text = f"Чаты ({len(chats)}/{settings['max_chats']}):\n" + "\n".join(
                [f"{i+1}. {chat.get('title', chat['id'])}" for i, chat in enumerate(chats)]
            )
        await callback.message.edit_text(text, reply_markup=chats_inline_keyboard(account_id, chats))
    else:
        await callback.answer("Чат не найден.", show_alert=True)

@dp.callback_query(F.data.startswith("acc_show_msgs_"))
async def show_last_messages(callback: types.CallbackQuery):
    account_id = int(callback.data.split("_")[3])
    user_id = callback.from_user.id
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        await callback.answer("Аккаунт не найден.", show_alert=True)
        return
    if not acc['chats']:
        await callback.answer("Нет чатов.", show_alert=True)
        return
    kb = InlineKeyboardMarkup(inline_keyboard=[])
    for i, chat in enumerate(acc['chats']):
        title = chat.get('title', str(chat['id']))
        kb.inline_keyboard.append([InlineKeyboardButton(text=title, callback_data=f"acc_show_chat_{account_id}_{i}")])
    kb.inline_keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_chats_{account_id}")])
    await callback.message.edit_text("Выберите чат для просмотра последних 3 сообщений:", reply_markup=kb)
    await callback.answer()

@dp.callback_query(F.data.startswith("acc_show_chat_"))
async def show_chat_messages(callback: types.CallbackQuery):
    parts = callback.data.split("_")
    account_id = int(parts[3])
    index = int(parts[4])
    user_id = callback.from_user.id
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        await callback.answer("Аккаунт не найден.", show_alert=True)
        return
    chats = acc['chats']
    if not (0 <= index < len(chats)):
        await callback.answer("Чат не найден.", show_alert=True)
        return
    chat = chats[index]
    chat_id = chat['id']
    title = chat.get('title', str(chat_id))
    client = TelegramClient(StringSession(acc['session_string']), API_ID, API_HASH)
    try:
        await client.start()
        messages = await client.get_messages(chat_id, limit=3)
        if not messages:
            text = f"В чате '{title}' нет сообщений."
        else:
            text = f"Последние 3 сообщения в чате '{title}':\n\n"
            for msg in messages:
                sender = msg.sender_id if msg.sender_id else "Unknown"
                text += f"👤 {sender}: {msg.text or '[медиа]'}\n"
        await callback.message.edit_text(text, reply_markup=chats_inline_keyboard(account_id, chats))
    except Exception as e:
        await callback.message.edit_text(f"Ошибка: {e}", reply_markup=chats_inline_keyboard(account_id, chats))
    finally:
        await client.disconnect()
    await callback.answer()

# ---------- ПОИСК ЧАТОВ ----------
@dp.message(F.text == "🔍 Поиск чатов")
async def search_chats_start(message: types.Message, state: FSMContext):
    user_id = message.from_user.id
    settings = await get_user_settings(user_id)
    accounts = await get_accounts(user_id)
    active = [a for a in accounts if a['is_active']]
    if not active:
        await message.answer("Нет активных аккаунтов. Добавьте или включите аккаунт.")
        return
    kb = InlineKeyboardMarkup(inline_keyboard=[])
    for acc in active:
        username = acc['username'] if acc['username'] else acc['phone']
        used = len(acc['chats'])
        kb.inline_keyboard.append([
            InlineKeyboardButton(
                text=f"@{username} [{used}/{settings['max_chats']}]",
                callback_data=f"search_acc_{acc['id']}"
            )
        ])
    kb.inline_keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data="back_to_main")])
    await message.answer(
        f"Выберите аккаунт для автопоиска.\n"
        f"Фильтры: ≥{settings['min_participants']} участников, "
        f"≤{settings['activity_days']} дн. активности, "
        f"лимит {settings['max_chats']} чатов.",
        reply_markup=kb
    )

@dp.callback_query(F.data.startswith("search_acc_"))
async def search_account_selected(callback: types.CallbackQuery, state: FSMContext):
    account_id = int(callback.data.split("_")[2])
    await state.update_data(account_id=account_id)
    await callback.message.answer(
        "Введите ключевые слова через запятую.\n"
        "Например: p2p, крипта, арбитраж, обменник, usdt, чат, биржа"
    )
    await state.set_state(SearchChatsStates.waiting_query)
    await callback.answer()

@dp.message(SearchChatsStates.waiting_query)
async def search_query_input(message: types.Message, state: FSMContext):
    query = message.text.strip()
    data = await state.get_data()
    account_id = data.get('account_id')
    user_id = message.from_user.id
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        await message.answer("Аккаунт не найден.")
        await state.clear()
        return

    settings = await get_user_settings(user_id)
    min_p = settings['min_participants']
    max_c = settings['max_chats']
    act_d = settings['activity_days']

    keywords = [k.strip() for k in query.split(',') if k.strip()]
    if not keywords:
        await message.answer("Пустой запрос.")
        await state.clear()
        return

    status_msg = await message.answer(
        f"🔎 Ищу и вступаю...\n"
        f"Слов: {len(keywords)}\n"
        f"Фильтры: ≥{min_p} участников, ≤{act_d} дн., лимит {max_c}."
    )

    client = TelegramClient(StringSession(acc['session_string']), API_ID, API_HASH)
    try:
        await client.start()
        added, err = await search_and_join_chats(client, account_id, user_id, keywords, min_p, max_c, act_d)
        if err:
            await status_msg.edit_text(f"❌ {err}")
        else:
            lines = [f"✅ Добавлено {len(added)}:\n"]
            for c in added:
                lines.append(f"• {c['title']}")
            await status_msg.edit_text("\n".join(lines))
    except Exception as e:
        await status_msg.edit_text(f"❌ Ошибка: {e}")
    finally:
        await client.disconnect()
        await state.clear()

@dp.callback_query(F.data == "back_to_main")
async def back_to_main_callback(callback: types.CallbackQuery):
    await callback.message.delete()
