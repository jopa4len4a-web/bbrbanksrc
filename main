@dp.message(F.text == "🤝 Партнёрство")
async def partnership_main_menu(message: types.Message):
    user_id = message.from_user.id
    await ensure_user(user_id, message.from_user.username)
    partner_id = await get_partner_id(user_id)
    my_accounts = await get_accounts(user_id)
    if partner_id:
        async with aiosqlite.connect(DB_PATH) as db:
            cursor = await db.execute("SELECT username FROM users WHERE user_id = ?", (partner_id,))
            row = await cursor.fetchone()
        partner_name = f"@{row[0]}" if row and row[0] else f"id{partner_id}"
        partner_accounts = await get_accounts(partner_id)
        text = (
            f"🤝 Партнёрство аккаунтов\n\n"
            f"Партнёр: {partner_name}\n"
            f"Ваших аккаунтов: {len(my_accounts)}\n"
            f"Аккаунтов партнёра: {len(partner_accounts)}\n\n"
            f"Новые аккаунты автоматически передаются партнёру, и наоборот."
        )
    else:
        text = (
            f"🤝 Партнёрство аккаунтов\n\n"
            f"Партнёр не привязан.\n"
            f"Ваших аккаунтов: {len(my_accounts)}\n\n"
            f"После привязки все новые аккаунты будут автоматически "
            f"добавляться партнёру, а его — вам."
        )
    await message.answer(text, reply_markup=partnership_main_keyboard(bool(partner_id)))

