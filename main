# ---------- ЧАТЫ РАССЫЛКИ ----------
@dp.callback_query(F.data.startswith("acc_chats_"))
async def show_chats(callback: types.CallbackQuery):
    account_id = int(callback.data.split("_")[2])
    acc = await get_account(account_id, callback.from_user.id)
    if not acc:
        await callback.answer("Не найден.", show_alert=True)
        return
    text = "✉️ Чаты рассылки:\n" + (
        "\n".join(f"{i+1}. {c.get('title')}" for i, c in enumerate(acc["chats"]))
        if acc["chats"] else "Пусто."
    )
    try:
        await callback.message.edit_text(text, reply_markup=chats_menu(account_id, acc["chats"]))
    except TelegramBadRequest:
        pass
    await callback.answer()


@dp.callback_query(F.data.startswith("chat_pick_"))
async def pick_chat(callback: types.CallbackQuery, state: FSMContext):
    account_id = int(callback.data.split("_")[2])
    acc = await get_account(account_id, callback.from_user.id)
    if not acc:
        await callback.answer("Не найден.", show_alert=True)
        return
    await callback.answer("Загружаю...")
    dialogs = await get_dialogs(acc)
    if not dialogs:
        await callback.message.answer("Нет чатов.")
        return
    await state.update_data(dialogs=dialogs)
    try:
        await callback.message.edit_text("Выбери чат:", reply_markup=picker_menu(account_id, dialogs, "chat"))
    except TelegramBadRequest:
        pass


@dp.callback_query(F.data.startswith("chat_add_"))
async def add_chat(callback: types.CallbackQuery, state: FSMContext):
    parts = callback.data.split("_")
    account_id = int(parts[2])
    idx = int(parts[3])
    data = await state.get_data()
    dialogs = data.get("dialogs", [])
    if not (0 <= idx < len(dialogs)):
        await callback.answer("Ошибка.", show_alert=True)
        return
    acc = await get_account(account_id, callback.from_user.id)
    new = dialogs[idx]
    chats = acc["chats"]
    if not any(c["id"] == new["id"] for c in chats):
        chats.append(new)
        await save_chats(account_id, callback.from_user.id, chats)
    await callback.answer(f"+ {new['title']}")
    text = "✉️ Чаты рассылки:\n" + "\n".join(f"{i+1}. {c.get('title')}" for i, c in enumerate(chats))
    try:
        await callback.message.edit_text(text, reply_markup=chats_menu(account_id, chats))
    except TelegramBadRequest:
        pass


@dp.callback_query(F.data.startswith("chat_del_"))
async def delete_chat(callback: types.CallbackQuery):
    parts = callback.data.split("_")
    account_id = int(parts[2])
    idx = int(parts[3])
    acc = await get_account(account_id, callback.from_user.id)
    if not acc:
        await callback.answer("Не найден.", show_alert=True)
        return
    chats = acc["chats"]
    if 0 <= idx < len(chats):
        chats.pop(idx)
        await save_chats(account_id, callback.from_user.id, chats)
    await callback.answer("Удалено")
    text = "✉️ Чаты рассылки:\n" + (
        "\n".join(f"{i+1}. {c.get('title')}" for i, c in enumerate(chats))
        if chats else "Пусто."
    )
    try:
        await callback.message.edit_text(text, reply_markup=chats_menu(account_id, chats))
    except TelegramBadRequest:
        pass


