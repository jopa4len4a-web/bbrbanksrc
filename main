async def stats(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT status, COUNT(*) FROM queue WHERE user_id = ? GROUP BY status", (uid,))
        return {r[0]: r[1] for r in await cur.fetchall()}


async def error_stats(uid):
    """Возвращает {error_text: count} для failed статусов."""
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute(
            "SELECT error, COUNT(*) FROM queue WHERE user_id = ? AND status = 'failed' AND error IS NOT NULL GROUP BY error ORDER BY COUNT(*) DESC",
            (uid,))
        return [(r[0], r[1]) for r in await cur.fetchall()]


async def save_jobs(uid, mailing_id=None, parsing_id=None):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT mailing_id, parsing_id FROM jobs WHERE user_id = ?", (uid,))
        r = await cur.fetchone()
        old_m = r[0] if r else None
        old_p = r[1] if r else None
        new_m = mailing_id if mailing_id is not None else old_m
        new_p = parsing_id if parsing_id is not None else old_p
        await db.execute("INSERT OR REPLACE INTO jobs (user_id, mailing_id, parsing_id) VALUES (?, ?, ?)",
                         (uid, new_m, new_p))
        await db.commit()


async def get_jobs(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT mailing_id, parsing_id FROM jobs WHERE user_id = ?", (uid,))
        r = await cur.fetchone()
        return (r[0], r[1]) if r else (None, None)


# ---------- РАССЫЛКА ----------
async def send_messages_for_user(uid):
    try:
        accounts = [a for a in await get_accounts(uid) if a["is_active"]]
        messages = await get_messages(uid)
        if not accounts or not messages:
            return
        for acc in accounts:
            if not acc["chats"]:
                continue
            client = make_client(acc["session_string"])
            try:
                await client.start()
                for chat in acc["chats"]:
                    for msg in messages:
                        try:
                            await client.send_message(chat["id"], msg["text"])
                            await inc_sent(acc["id"], uid, 1)
                            await asyncio.sleep(1)
                        except FloodWaitError as e:
                            await asyncio.sleep(e.seconds)
                        except Exception as e:
                            logging.error(f"send[{acc['phone']}]: {e}")
            except Exception as e:
                logging.error(f"mailing client[{acc['phone']}]: {e}")
            finally:
                try:
                    await client.disconnect()
                except Exception:
                    pass
    except Exception as e:
        logging.error(f"send_messages_for_user[{uid}]: {e}")


async def start_mailing(uid):
    mid, _ = await get_jobs(uid)
    if mid:
        try:
            scheduler.get_job(mid)
            return False
        except JobLookupError:
            pass
    settings = await get_settings(uid)
    job = scheduler.add_job(send_messages_for_user, "interval",
                            seconds=settings["interval"], args=[uid],
                            id=f"mail_{uid}", replace_existing=True,
                            max_instances=1, coalesce=True, misfire_grace_time=120)
    await save_jobs(uid, mailing_id=job.id)
    asyncio.create_task(send_messages_for_user(uid))
    return True


async def stop_mailing(uid):
    mid, _ = await get_jobs(uid)
    if mid:
        try:
            scheduler.remove_job(mid)
        except JobLookupError:
            pass
    await save_jobs(uid, mailing_id="")


# ---------- ПАРСИНГ ----------
async def parse_source(client, src):
    try:
        entity = await client.get_entity(src.get("id") or src.get("username"))
    except Exception as e:
        logging.warning(f"parse_source entity {src.get('title')}: {e}")
        return []

    if isinstance(entity, tl_types.Channel):
        try:
            result = []
            offset = 0
            step = 200
            while True:
                part = await client(functions.channels.GetParticipantsRequest(
                    channel=entity, filter=ChannelParticipantsSearch(''),
                    offset=offset, limit=step, hash=0))
                if not part or not part.users:
                    break
                for u in part.users:
                    if not isinstance(u, tl_types.User):
                        continue
                    if u.bot:
                        continue
                    if not getattr(u, "username", None):
                        continue
                    if not getattr(u, "access_hash", None):
                        continue
                    result.append({"id": u.id, "username": u.username,
                                   "first_name": u.first_name or "",
                                   "last_name": u.last_name or "",
                                   "access_hash": u.access_hash})
                offset += step
                if len(part.users) < step:
                    break
            if result:
                logging.info(f"parsed {len(result)} via participants from {src.get('title')}")
                return result
        except Exception as e:
            logging.info(f"GetParticipants failed for {src.get('title')}: {e}")

    if isinstance(entity, tl_types.Channel) and getattr(entity, "broadcast", False) and not getattr(entity, "megagroup", False):
        linked_id = getattr(entity, "linked_chat_id", None)
        if linked_id:
            try:
                linked = await client.get_entity(linked_id)
                result = await parse_from_messages(client, linked)
                if result:
                    logging.info(f"parsed {len(result)} from linked chat of {src.get('title')}")
                    return result
            except Exception as e:
                logging.info(f"linked chat failed for {src.get('title')}: {e}")
        logging.info(f"skip broadcast channel {src.get('title')} — no linked chat / no users")
        return []

    return await parse_from_messages(client, entity)


async def parse_from_messages(client, entity):
    result = []
    seen_ids = set()
    scanned = 0
    try:
        async for msg in client.iter_messages(entity):
            scanned += 1
            if scanned > MAX_MESSAGES_SCAN:
                break
            try:
                sender = await msg.get_sender()
            except Exception:
                continue
            if sender is None:
                continue
            if not isinstance(sender, tl_types.User):
                continue
            if getattr(sender, "bot", False):
                continue
            if not getattr(sender, "username", None):
                continue
            if not getattr(sender, "access_hash", None):
                continue
            if sender.id in seen_ids:
                continue
            seen_ids.add(sender.id)
            result.append({
                "id": sender.id,
                "username": sender.username,
                "first_name": sender.first_name or "",
                "last_name": sender.last_name or "",
                "access_hash": sender.access_hash,
            })
    except Exception as e:
        logging.warning(f"parse_from_messages: {e}")
    return result


async def is_in_target(client, target, tg_id):
    try:
        entity = await client.get_entity(target["id"])
        await client(GetParticipantRequest(channel=entity, participant=tg_id))
        return True
    except Exception:
        return False


async def invite(client, target, u):
    try:
        await client(AddContactRequest(
            id=InputPeerUser(u["id"], u["access_hash"]),
            first_name=u["first_name"] or u["username"] or "User",
            last_name=u["last_name"] or "",
            phone="",
            add_phone_privacy_exception=False))
    except FloodWaitError as e:
        await asyncio.sleep(e.seconds + 1)
        try:
            await client(AddContactRequest(
                id=InputPeerUser(u["id"], u["access_hash"]),
                first_name=u["first_name"] or u["username"] or "User",
                last_name=u["last_name"] or "",
                phone="",
                add_phone_privacy_exception=False))
        except Exception:
            pass
    except UserPrivacyRestrictedError:
        return False, "privacy_restricted"
    except Exception:
        pass

    try:
        if target["type"] == "channel":
            await client(InviteToChannelRequest(
                channel=InputPeerChannel(target["id"], target["access_hash"]),
                users=[InputPeerUser(u["id"], u["access_hash"])]))
        else:
            await client(AddChatUserRequest(
                chat_id=target["id"],
                user_id=InputPeerUser(u["id"], u["access_hash"]), fwd_limit=100))
        return True, "invited"
    except UserAlreadyParticipantError:
        return False, "already_participant"
    except UserNotMutualContactError:
        return False, "not_mutual_contact"
    except UserChannelsTooMuchError:
        return False, "target_channels_too_much"
    except ChatAdminRequiredError:
        return False, "no_admin_rights"
    except PeerFloodError:
        return False, "peer_flood"
    except FloodWaitError as e:
        await asyncio.sleep(e.seconds + 1)
        return False, f"flood_wait_{e.seconds}s"
    except Exception as e:
        return False, f"error: {type(e).__name__}: {e}"


async def parse_only(uid):
    if f"parse_{uid}" in RUNNING:
        return
    RUNNING.add(f"parse_{uid}")
    logging.info(f"parse[{uid}] START")
    try:
        accounts = [a for a in await get_accounts(uid) if a["is_active"]]
        for acc in accounts:
            if not acc["sources"]:
                continue
            client = make_client(acc["session_string"])
            try:
                await client.start()
                total = 0
                for src in acc["sources"]:
                    users = await parse_source(client, src)
                    target = acc["target"] if acc["target"] else {"id": 0, "type": "channel", "access_hash": 0}
                    for u in users:
                        if acc["target"] and await is_in_target(client, acc["target"], u["id"]):
                            continue
                        if await enqueue(uid, acc["id"], target, u):
                            total += 1
                if total:
                    await inc_parsed(acc["id"], uid, total)
                    logging.info(f"parse[{uid}] +{total} new users")
            except Exception as e:
                logging.error(f"parse[{acc['phone']}]: {e}")
            finally:
                try:
                    await client.disconnect()
                except Exception:
                    pass
    except Exception as e:
        logging.error(f"parse_only[{uid}]: {e}")
    finally:
        RUNNING.discard(f"parse_{uid}")
        logging.info(f"parse[{uid}] DONE")


async def invite_only(uid, limit):
    """Инвайтит до limit юзеров (0 = все). Возвращает отчёт."""
    if f"invite_{uid}" in RUNNING:
        return None
    RUNNING.add(f"invite_{uid}")
    logging.info(f"invite[{uid}] START limit={limit}")

    invited_count = 0
    failed_reasons = {}
    skipped_reasons = {}

    try:
        accounts = [a for a in await get_accounts(uid) if a["is_active"]]
        target_acc = next((a for a in accounts if a["target"]), None)
        if not target_acc:
            logging.warning(f"invite[{uid}] no target")
            return {"invited": 0, "total": 0, "failed": {}, "skipped": {}, "error": "нет цели"}

        batch = await pop_batch(uid, limit if limit > 0 else 100000)
        if not batch:
            logging.info(f"invite[{uid}] queue empty")
            return {"invited": 0, "total": 0, "failed": {}, "skipped": {}, "error": "очередь пуста"}

        logging.info(f"invite[{uid}] inviting {len(batch)} users")
        client = make_client(target_acc["session_string"])
        try:
            await client.start()
            for it in batch:
                target = {"id": it["target_id"], "type": it["target_type"],
                          "access_hash": it["target_access_hash"]}
                u = {"id": it["uid"], "username": it["user_username"],
                     "first_name": it["first_name"], "last_name": it["last_name"],
                     "access_hash": it["access_hash"]}
                ok, reason = await invite(client, target, u)
                if ok:
                    await set_status(it["id"], "invited")
                    await mark_invited(uid, it["target_id"], it["uid"])
                    await inc_invited(target_acc["id"], uid, 1)
                    invited_count += 1
                else:
                    if reason in ("already_participant", "not_mutual_contact",
                                  "target_channels_too_much", "privacy_restricted",
                                  "no_admin_rights", "peer_flood"):
                        await set_status(it["id"], "skipped", reason)
                        await mark_invited(uid, it["target_id"], it["uid"])
                        skipped_reasons[reason] = skipped_reasons.get(reason, 0) + 1
                    elif reason.startswith("flood_wait_") or reason.startswith("flood_contact_"):
                        await set_status(it["id"], "pending")
                        try:
                            secs = int(reason.split("_")[-1].rstrip("s"))
                        except Exception:
                            secs = 60
                        await asyncio.sleep(secs + 1)
                        ok2, reason2 = await invite(client, target, u)
                        if ok2:
                            await set_status(it["id"], "invited")
                            await mark_invited(uid, it["target_id"], it["uid"])
                            await inc_invited(target_acc["id"], uid, 1)
                            invited_count += 1
                        else:
                            await set_status(it["id"], "failed", reason2)
                            failed_reasons[reason2] = failed_reasons.get(reason2, 0) + 1
                    else:
                        await set_status(it["id"], "failed", reason)
                        failed_reasons[reason] = failed_reasons.get(reason, 0) + 1
                await asyncio.sleep(0.1)
        except Exception as e:
            logging.error(f"invite[{target_acc['phone']}]: {e}")
            for it in batch:
                cur = await get_queue_item(it["id"])
                if cur and cur["status"] == "pending":
                    await set_status(it["id"], "failed", str(e))
                    failed_reasons[str(e)] = failed_reasons.get(str(e), 0) + 1
        finally:
            try:
                await client.disconnect()
            except Exception:
                pass
    except Exception as e:
        logging.error(f"invite_only[{uid}]: {e}")
        return {"invited": invited_count, "total": 0, "failed": {str(e): 1}, "skipped": {}, "error": str(e)}
    finally:
        RUNNING.discard(f"invite_{uid}")
        logging.info(f"invite[{uid}] DONE invited={invited_count}")

    return {
        "invited": invited_count,
        "total": len(batch),
        "failed": failed_reasons,
        "skipped": skipped_reasons,
        "error": None,
    }


async def start_parsing(uid):
    _, pid = await get_jobs(uid)
    if pid:
        try:
            scheduler.get_job(pid)
            return False
        except JobLookupError:
            pass
    job = scheduler.add_job(parse_only, "interval",
                            seconds=PARSE_INTERVAL, args=[uid],
                            id=f"parse_{uid}", replace_existing=True,
                            max_instances=1, coalesce=True, misfire_grace_time=60)
    await save_jobs(uid, parsing_id=job.id)
    asyncio.create_task(parse_only(uid))
    return True


async def stop_parsing(uid):
    _, pid = await get_jobs(uid)
    if pid:
        try:
            scheduler.remove_job(pid)
        except JobLookupError:
            pass
    await save_jobs(uid, parsing_id="")


async def restore_jobs():
    logging.info("restore_jobs start")
    try:
        async with aiosqlite.connect(DB_PATH) as db:
            cur = await db.execute("SELECT user_id, mailing_id, parsing_id FROM jobs")
            for r in await cur.fetchall():
                uid, mid, pid = r
                if mid:
                    try:
                        scheduler.get_job(mid)
                    except JobLookupError:
                        await start_mailing(uid)
                if pid:
                    try:
                        scheduler.get_job(pid)
                    except JobLookupError:
                        await start_parsing(uid)
        logging.info("restore_jobs done")
    except Exception as e:
        logging.error(f"restore_jobs: {e}")


async def is_mailing_running(uid):
    mid, _ = await get_jobs(uid)
    if not mid:
        return False
    try:
        scheduler.get_job(mid)
        return True
    except JobLookupError:
        return False


async def is_parsing_running(uid):
    _, pid = await get_jobs(uid)
    if not pid:
        return False
    try:
        scheduler.get_job(pid)
        return True
    except JobLookupError:
        return False


async def get_dialogs(acc, limit=200):
    client = make_client(acc["session_string"])
    out = []
    try:
        await client.start()
        dialogs = await client.get_dialogs(limit=limit)
        for d in dialogs:
            if not d.is_group and not d.is_channel:
                continue
            try:
                peer_id = utils.get_peer_id(d.entity)
                access_hash = getattr(d.entity, "access_hash", 0) or 0
                is_broadcast = bool(getattr(d.entity, "broadcast", False))
                is_megagroup = bool(getattr(d.entity, "megagroup", False))
                out.append({"id": peer_id, "access_hash": access_hash,
                            "title": d.title or str(peer_id),
                            "username": getattr(d.entity, "username", None),
                            "type": "channel" if (is_broadcast or is_megagroup) else "chat"})
            except Exception:
                continue
    except Exception as e:
        logging.error(f"get_dialogs: {e}")
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    return out


