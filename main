# ---------- СТАРТ / СТОП РАССЫЛКИ ----------
@dp.message(F.text == "▶️ Запустить рассылку")
async def start_mailing(message: types.Message):
    user_id = message.from_user.id
    job_id = await get_job_id(user_id)
    if job_id:
        try:
            scheduler.get_job(job_id)
            await message.answer("Рассылка уже запущена.")
            return
        except JobLookupError:
            await delete_job_id(user_id)
    accounts = await get_accounts(user_id)
    active_accounts = [a for a in accounts if a['is_active']]
    if not active_accounts:
        await message.answer("Нет активных аккаунтов."); return
    for acc in active_accounts:
        if not acc['chats']:
            await message.answer(f"У @{acc['username'] or 'без ника'} нет чатов."); return
    if not await get_messages(user_id):
        await message.answer("Нет сообщений."); return
    await start_scheduler_for_user(user_id)
    asyncio.create_task(send_messages_for_user(user_id))
    kb = await get_main_keyboard(user_id)
    await message.answer("Рассылка запущена!", reply_markup=kb)

@dp.message(F.text == "⏹ Остановить рассылку")
async def stop_mailing(message: types.Message):
    await stop_scheduler_for_user(message.from_user.id)
    kb = await get_main_keyboard(message.from_user.id)
    await message.answer("Рассылка остановлена.", reply_markup=kb)

@dp.message(F.text == "🔙 Назад")
async def back_to_main(message: types.Message):
    kb = await get_main_keyboard(message.from_user.id)
    await message.answer("Главное меню:", reply_markup=kb)

# ---------- ЗАПУСК ----------
async def main():
    await init_db()
    bot = Bot(token=BOT_TOKEN)
    await rejoin_active_chats_on_startup()
    await restore_schedulers_on_startup()
    if not scheduler.running:
        scheduler.start()
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
