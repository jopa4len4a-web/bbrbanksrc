@dp.callback_query(F.data == "filter_min_participants")
async def filter_min_participants(callback: types.CallbackQuery, state: FSMContext):
    await callback.message.answer("Введите минимум участников (целое число):")
    await state.set_state(FilterStates.waiting_min_participants)
    await callback.answer()

@dp.message(FilterStates.waiting_min_participants)
async def set_min_participants(message: types.Message, state: FSMContext):
    try:
        val = int(message.text.strip())
        if val < 0:
            raise ValueError
        await update_user_setting(message.from_user.id, "min_participants", val)
        await message.answer(f"✅ Установлено: {val}")
        await state.clear()
        settings = await get_user_settings(message.from_user.id)
        text = (
            f"🎯 Фильтры поиска\n\n"
            f"👥 Мин. участников: {settings['min_participants']}\n"
            f"📊 Макс. чатов: {settings['max_chats']}\n"
            f"⏰ Активность: {settings['activity_days']} дн."
        )
        await message.answer(text, reply_markup=filters_keyboard())
    except ValueError:
        await message.answer("Введите целое положительное число.")

@dp.callback_query(F.data == "filter_max_chats")
async def filter_max_chats(callback: types.CallbackQuery, state: FSMContext):
    await callback.message.answer("Введите максимум чатов на аккаунт:")
    await state.set_state(FilterStates.waiting_max_chats)
    await callback.answer()

@dp.message(FilterStates.waiting_max_chats)
async def set_max_chats(message: types.Message, state: FSMContext):
    try:
        val = int(message.text.strip())
        if val < 1 or val > 500:
            await message.answer("От 1 до 500.")
            return
        await update_user_setting(message.from_user.id, "max_chats", val)
        await message.answer(f"✅ Установлено: {val}")
        await state.clear()
        settings = await get_user_settings(message.from_user.id)
        text = (
            f"🎯 Фильтры поиска\n\n"
            f"👥 Мин. участников: {settings['min_participants']}\n"
            f"📊 Макс. чатов: {settings['max_chats']}\n"
            f"⏰ Активность: {settings['activity_days']} дн."
        )
        await message.answer(text, reply_markup=filters_keyboard())
    except ValueError:
        await message.answer("Введите целое число.")

@dp.callback_query(F.data == "filter_activity_days")
async def filter_activity_days(callback: types.CallbackQuery, state: FSMContext):
    await callback.message.answer("Введите максимум дней с последнего сообщения:")
    await state.set_state(FilterStates.waiting_activity_days)
    await callback.answer()

@dp.message(FilterStates.waiting_activity_days)
async def set_activity_days(message: types.Message, state: FSMContext):
    try:
        val = int(message.text.strip())
        if val < 1 or val > 365:
            await message.answer("От 1 до 365.")
            return
        await update_user_setting(message.from_user.id, "activity_days", val)
        await message.answer(f"✅ Установлено: ≤{val} дн.")
        await state.clear()
        settings = await get_user_settings(message.from_user.id)
        text = (
            f"🎯 Фильтры поиска\n\n"
            f"👥 Мин. участников: {settings['min_participants']}\n"
            f"📊 Макс. чатов: {settings['max_chats']}\n"
            f"⏰ Активность: {settings['activity_days']} дн."
        )
        await message.answer(text, reply_markup=filters_keyboard())
    except ValueError:
        await message.answer("Введите целое число.")

@dp.callback_query(F.data == "settings_back")
async def settings_back(callback: types.CallbackQuery):
    try:
        await callback.message.edit_text("Выберите раздел:", reply_markup=settings_keyboard())
    except TelegramBadRequest:
        pass
    await callback.answer()

# ---------- ЗАПУСК / СТОП РАССЫЛКИ ----------
@dp.message(F.text == "▶️ Запустить рассылку")
async def start_mailing(message: types.Message):
    user_id = message.from_user.id
    job_id = await get_job_id(user_id)
    if job_id:
        try:
            scheduler.get_job(job_id)
            await message.answer("Рассылка уже запущена.")
            return
        except JobLookupError:
            await delete_job_id(user_id)

    accounts = await get_accounts(user_id)
    active_accounts = [a for a in accounts if a['is_active']]
    if not active_accounts:
        await message.answer("Нет активных аккаунтов.")
        return
    for acc in active_accounts:
        if not acc['chats']:
            await message.answer(f"У аккаунта @{acc['username'] if acc['username'] else 'без ника'} нет чатов.")
            return
    messages = await get_messages(user_id)
    if not messages:
        await message.answer("Нет сообщений.")
        return

    await start_scheduler_for_user(user_id)
    asyncio.create_task(send_messages_for_user(user_id))

    kb = ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="📋 Аккаунты")],
            [KeyboardButton(text="🔍 Поиск чатов")],
            [KeyboardButton(text="⚙️ Настройки")],
            [KeyboardButton(text="⏹ Остановить рассылку")]
        ],
        resize_keyboard=True
    )
    await message.answer("Рассылка запущена!", reply_markup=kb)

@dp.message(F.text == "⏹ Остановить рассылку")
async def stop_mailing(message: types.Message):
    await stop_scheduler_for_user(message.from_user.id)
    kb = ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="📋 Аккаунты")],
            [KeyboardButton(text="🔍 Поиск чатов")],
            [KeyboardButton(text="⚙️ Настройки")],
            [KeyboardButton(text="▶️ Запустить рассылку")]
        ],
        resize_keyboard=True
    )
    await message.answer("Рассылка остановлена.", reply_markup=kb)

@dp.message(F.text == "🔙 Назад")
async def back_to_main(message: types.Message):
    await message.answer("Главное меню:", reply_markup=main_keyboard())

# ---------- ЗАПУСК ----------
async def main():
    await init_db()
    bot = Bot(token=BOT_TOKEN)
    await rejoin_active_chats_on_startup()
    if not scheduler.running:
        scheduler.start()
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
