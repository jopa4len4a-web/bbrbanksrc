    await st.set_state(S_set.parse_limit)
    await cb.answer()


@dp.message(S_set.parse_limit)
async def set_parse_limit_save(m: types.Message, st: FSMContext):
    try:
        v = int(m.text.strip())
        if v < 10 or v > 5000:
            raise ValueError
        await set_setting(m.from_user.id, "parse_limit", v)
        await m.answer(f"✅ {v}")
    except ValueError:
        await m.answer("Число 10–5000.")
    await st.clear()


