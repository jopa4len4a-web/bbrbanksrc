@dp.callback_query(F.data.startswith("prof_user_"))
async def prof_user_start(callback: types.CallbackQuery, state: FSMContext):
    account_id = int(callback.data.split("_")[2])
    await state.update_data(account_id=account_id)
    await callback.message.answer(
        "Введите новый юзернейм (5-32 символа, a-z, 0-9, _).\n"
        "Отправьте «-» чтобы удалить."
    )
    await state.set_state(ProfileEditStates.waiting_username)
    await callback.answer()

@dp.message(ProfileEditStates.waiting_username)
async def prof_set_username(message: types.Message, state: FSMContext):
    new_user = message.text.strip().lstrip('@')
    if new_user == "-":
        new_user = ""
    elif len(new_user) < 5 or len(new_user) > 32 or not all(c.isalnum() or c == '_' for c in new_user):
        await message.answer("Неверный формат.")
        return
    data = await state.get_data()
    account_id = data['account_id']
    user_id = message.from_user.id
    acc = await get_account_by_id(account_id, user_id)
    client = TelegramClient(StringSession(acc['session_string']), API_ID, API_HASH)
    try:
        await client.start()
        try:
            await client(UpdateUsernameRequest(username=new_user))
        except UsernameOccupiedError:
            await message.answer("❌ Юзернейм занят.")
            await client.disconnect(); await state.clear(); return
        except UsernameInvalidError:
            await message.answer("❌ Неверный формат.")
            await client.disconnect(); await state.clear(); return
        await update_account_username(account_id, user_id, new_user or None)
        await message.answer(f"✅ Юзернейм: @{new_user if new_user else '(удалён)'}.")
    except FloodWaitError as e:
        await message.answer(f"Подожди {e.seconds} сек.")
    except Exception as e:
        await message.answer(f"❌ Ошибка: {e}")
    finally:
        await client.disconnect()
    await state.clear()

@dp.callback_query(F.data.startswith("prof_avatar_"))
async def prof_avatar_start(callback: types.CallbackQuery, state: FSMContext):
    account_id = int(callback.data.split("_")[2])
    await state.update_data(account_id=account_id)
    await callback.message.answer(
        "Отправьте фото для установки на аватар.\n"
        "Или отправьте «-» чтобы удалить."
    )
    await state.set_state(ProfileEditStates.waiting_avatar)
    await callback.answer()

@dp.message(ProfileEditStates.waiting_avatar, F.photo | F.text)
async def prof_set_avatar(message: types.Message, state: FSMContext):
    data = await state.get_data()
    account_id = data['account_id']
    user_id = message.from_user.id
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        await message.answer("Аккаунт не найден.")
        await state.clear(); return
    client = TelegramClient(StringSession(acc['session_string']), API_ID, API_HASH)
    try:
        await client.start()
        if message.text and message.text.strip() == "-":
            try:
                photos = await client(GetUserPhotosRequest(user_id='me', offset=0, max_id=0, limit=100))
                if photos.photos:
                    await client(DeletePhotosRequest(id=photos.photos))
                await message.answer("✅ Аватар удалён.")
            except Exception as e:
                await message.answer(f"❌ {e}")
        elif message.photo:
            file = await message.bot.get_file(message.photo[-1].file_id)
            tmp_path = f"/tmp/avatar_{account_id}_{message.message_id}.jpg"
            await message.bot.download_file(file.file_path, tmp_path)
            try:
                uploaded = await client.upload_file(tmp_path)
                await client(UploadProfilePhotoRequest(file=uploaded))
                await message.answer("✅ Аватар установлен.")
            finally:
                try: os.remove(tmp_path)
                except Exception: pass
        else:
            await message.answer("Отправьте фото или «-».")
            await state.clear(); return
    except FloodWaitError as e:
        await message.answer(f"Подожди {e.seconds} сек.")
    except Exception as e:
        await message.answer(f"❌ Ошибка: {e}")
    finally:
        await client.disconnect()
    await state.clear()

