import os
import asyncio
import json
import logging
from datetime import datetime

from aiogram import Bot, Dispatcher, types, F
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
from aiogram.types import ReplyKeyboardMarkup, KeyboardButton, InlineKeyboardMarkup, InlineKeyboardButton
from aiogram.fsm.storage.memory import MemoryStorage
from aiogram.exceptions import TelegramBadRequest

from telethon import TelegramClient, functions, types as tl_types
from telethon.sessions import StringSession
from telethon.errors import SessionPasswordNeededError, FloodWaitError

from apscheduler.schedulers.asyncio import AsyncIOScheduler
from apscheduler.jobstores.base import JobLookupError

import aiosqlite

# ---------- ГЛОБАЛЬНЫЕ API (2040) ----------
API_ID = 2040
API_HASH = "b18441a1ff607e10a989891a5462e627"

BOT_TOKEN = os.getenv("BOT_TOKEN")
if not BOT_TOKEN:
    raise ValueError("BOT_TOKEN не задан")

DB_PATH = os.getenv("DB_PATH", "bot_data.db")
logging.basicConfig(level=logging.INFO)

# ---------- ДЕФОЛТНЫЕ ФИЛЬТРЫ ----------
DEFAULT_MIN_PARTICIPANTS = 300
DEFAULT_MAX_CHATS = 25
DEFAULT_ACTIVITY_DAYS = 7

# ---------- БАЗА ДАННЫХ ----------
async def init_db():
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute('''
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                interval_seconds INTEGER DEFAULT 3600,
                min_participants INTEGER DEFAULT 300,
                max_chats INTEGER DEFAULT 25,
                activity_days INTEGER DEFAULT 7
            )
        ''')
        await db.execute('''
            CREATE TABLE IF NOT EXISTS accounts (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                phone TEXT,
                username TEXT,
                session_string TEXT,
                is_active INTEGER DEFAULT 1,
                sent_count INTEGER DEFAULT 0,
                chats TEXT DEFAULT '[]',
                FOREIGN KEY(user_id) REFERENCES users(user_id)
            )
        ''')
        await db.execute('''
            CREATE TABLE IF NOT EXISTS messages (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                text TEXT,
                FOREIGN KEY(user_id) REFERENCES users(user_id)
            )
        ''')
        await db.execute('''
            CREATE TABLE IF NOT EXISTS scheduler_jobs (
                user_id INTEGER PRIMARY KEY,
                job_id TEXT
            )
        ''')
        await db.commit()

# ---------- CRUD ----------
async def get_user_settings(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute(
            "SELECT interval_seconds, min_participants, max_chats, activity_days FROM users WHERE user_id = ?",
            (user_id,)
        )
        row = await cursor.fetchone()
        if row:
            return {
                "interval_seconds": row[0],
                "min_participants": row[1],
                "max_chats": row[2],
                "activity_days": row[3]
            }
        else:
            await db.execute(
                "INSERT INTO users (user_id, interval_seconds, min_participants, max_chats, activity_days) VALUES (?, ?, ?, ?, ?)",
                (user_id, 3600, DEFAULT_MIN_PARTICIPANTS, DEFAULT_MAX_CHATS, DEFAULT_ACTIVITY_DAYS)
            )
            await db.commit()
            return {
                "interval_seconds": 3600,
                "min_participants": DEFAULT_MIN_PARTICIPANTS,
                "max_chats": DEFAULT_MAX_CHATS,
                "activity_days": DEFAULT_ACTIVITY_DAYS
            }

async def update_user_setting(user_id: int, key: str, value):
    allowed = {"interval_seconds", "min_participants", "max_chats", "activity_days"}
    if key not in allowed:
        return
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(f"UPDATE users SET {key} = ? WHERE user_id = ?", (value, user_id))
        await db.commit()

async def get_accounts(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute(
            "SELECT id, phone, username, session_string, is_active, sent_count, chats FROM accounts WHERE user_id = ?",
            (user_id,)
        )
        rows = await cursor.fetchall()
        return [{"id": r[0], "phone": r[1], "username": r[2], "session_string": r[3],
                 "is_active": bool(r[4]), "sent_count": r[5], "chats": json.loads(r[6])} for r in rows]

async def get_account_by_id(account_id: int, user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute(
            "SELECT id, phone, username, session_string, is_active, sent_count, chats FROM accounts WHERE id = ? AND user_id = ?",
            (account_id, user_id)
        )
        row = await cursor.fetchone()
        if row:
            return {"id": row[0], "phone": row[1], "username": row[2], "session_string": row[3],
                    "is_active": bool(row[4]), "sent_count": row[5], "chats": json.loads(row[6])}
        return None

async def add_account(user_id: int, phone: str, username: str, session_string: str):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(
            "INSERT INTO accounts (user_id, phone, username, session_string, chats) VALUES (?, ?, ?, ?, ?)",
            (user_id, phone, username, session_string, json.dumps([]))
        )
        await db.commit()

async def toggle_account_active(account_id: int, user_id: int, active: bool):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(
            "UPDATE accounts SET is_active = ? WHERE id = ? AND user_id = ?",
            (1 if active else 0, account_id, user_id)
        )
        await db.commit()

async def increment_sent_count(account_id: int, user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(
            "UPDATE accounts SET sent_count = sent_count + 1 WHERE id = ? AND user_id = ?",
            (account_id, user_id)
        )
        await db.commit()

async def update_account_chats(account_id: int, user_id: int, chats: list):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(
            "UPDATE accounts SET chats = ? WHERE id = ? AND user_id = ?",
            (json.dumps(chats), account_id, user_id)
        )
        await db.commit()

async def get_messages(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT id, text FROM messages WHERE user_id = ?", (user_id,))
        rows = await cursor.fetchall()
        return [{"id": r[0], "text": r[1]} for r in rows]

async def add_message(user_id: int, text: str):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("INSERT INTO messages (user_id, text) VALUES (?, ?)", (user_id, text))
        await db.commit()

async def delete_message(msg_id: int, user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM messages WHERE id = ? AND user_id = ?", (msg_id, user_id))
        await db.commit()

async def save_job_id(user_id: int, job_id: str):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("INSERT OR REPLACE INTO scheduler_jobs (user_id, job_id) VALUES (?, ?)", (user_id, job_id))
        await db.commit()

async def get_job_id(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT job_id FROM scheduler_jobs WHERE user_id = ?", (user_id,))
        row = await cursor.fetchone()
        return row[0] if row else None

async def delete_job_id(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM scheduler_jobs WHERE user_id = ?", (user_id,))
        await db.commit()

# ---------- КЛАВИАТУРЫ ----------
def main_keyboard():
    return ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="📋 Аккаунты")],
            [KeyboardButton(text="🔍 Поиск чатов")],
            [KeyboardButton(text="⚙️ Настройки")],
            [KeyboardButton(text="▶️ Запустить рассылку")]
        ],
        resize_keyboard=True
    )

def accounts_keyboard(accounts, max_chats=25):
    kb = []
    for acc in accounts:
        status = "✅" if acc['is_active'] else "❌"
        username = acc['username'] if acc['username'] else "без ника"
        display = f"{status} @{username} • {acc['phone']} • {len(acc['chats'])}/{max_chats}"
        kb.append([KeyboardButton(text=display)])
    kb.append([KeyboardButton(text="➕ Добавить аккаунт")])
    kb.append([KeyboardButton(text="🔙 Назад")])
    return ReplyKeyboardMarkup(keyboard=kb, resize_keyboard=True)

def account_detail_keyboard(account_id: int):
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🔄 Переключить активность", callback_data=f"acc_toggle_{account_id}")],
