# ---------- FSM ----------
class AddAccountStates(StatesGroup):
    waiting_phone = State()
    waiting_code = State()
    waiting_password = State()

class EditMessagesStates(StatesGroup):
    waiting_new_message = State()

class AddChatStates(StatesGroup):
    waiting_chat_input = State()

class SearchChatsStates(StatesGroup):
    waiting_query = State()

class FilterStates(StatesGroup):
    waiting_min_participants = State()
    waiting_max_chats = State()
    waiting_activity_days = State()

# ---------- ОТПРАВКА ----------
async def send_messages_for_user(user_id: int):
    try:
        accounts = await get_accounts(user_id)
        if not accounts:
            return
        messages = await get_messages(user_id)
        if not messages:
            return

        for acc in accounts:
            if not acc['is_active']:
                continue
            if not acc['chats']:
                continue
            client = TelegramClient(StringSession(acc['session_string']), API_ID, API_HASH)
            try:
                await client.start()
                for chat in acc['chats']:
                    chat_id = chat['id']
                    for msg in messages:
                        try:
                            await client.send_message(chat_id, msg['text'])
                            await increment_sent_count(acc['id'], user_id)
                            await asyncio.sleep(1)
                        except FloodWaitError as e:
                            logging.warning(f"FloodWait: ждём {e.seconds} сек")
                            await asyncio.sleep(e.seconds)
                        except Exception as e:
                            logging.error(f"Ошибка отправки в чат {chat_id}: {e}")
            except Exception as e:
                logging.error(f"Ошибка клиента для {acc['phone']}: {e}")
            finally:
                await client.disconnect()
    except Exception as e:
        logging.error(f"Ошибка в задаче для {user_id}: {e}")

# ---------- ПЛАНИРОВЩИК ----------
scheduler = AsyncIOScheduler()

async def start_scheduler_for_user(user_id: int):
    job_id = await get_job_id(user_id)
    if job_id:
        try:
            scheduler.get_job(job_id)
            return
        except JobLookupError:
            await delete_job_id(user_id)

    settings = await get_user_settings(user_id)
    interval = settings['interval_seconds']
    job = scheduler.add_job(
        send_messages_for_user,
        'interval',
        seconds=interval,
        args=[user_id],
        id=f"mailing_{user_id}",
        replace_existing=True
    )
    await save_job_id(user_id, job.id)

async def stop_scheduler_for_user(user_id: int):
    job_id = await get_job_id(user_id)
    if job_id:
        try:
            scheduler.remove_job(job_id)
        except JobLookupError:
            pass
        await delete_job_id(user_id)

# ---------- ВОССТАНОВЛЕНИЕ ЧАТОВ ПРИ СТАРТЕ ----------
async def rejoin_active_chats_on_startup():
    """Проверяет чаты всех аккаунтов и вступает заново в доступные."""
    logging.info("Проверка активных чатов всех аккаунтов...")
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT id, user_id, session_string, chats FROM accounts")
        rows = await cursor.fetchall()

    for row in rows:
        account_id = row[0]
        user_id = row[1]
        session_string = row[2]
        chats = json.loads(row[3])
        if not chats:
            continue

        client = TelegramClient(StringSession(session_string), API_ID, API_HASH)
        try:
            await client.start()
            try:
                dialogs = await client.get_dialogs()
                dialog_ids = set()
                for d in dialogs:
                    try:
                        dialog_ids.add(utils.get_peer_id(d.entity))
                    except Exception:
                        pass
            except Exception as e:
                logging.error(f"[acc {account_id}] Не удалось получить диалоги: {e}")
                dialog_ids = set()

            valid_chats = []
            removed = 0
            rejoined = 0

            for chat in chats:
                chat_id = chat['id']
                title = chat.get('title', str(chat_id))
                username = chat.get('username')

                if chat_id in dialog_ids:
                    valid_chats.append(chat)
                    continue

                joined = False
                try:
                    if username:
                        entity = await client.get_entity(username)
                        ok, reason = await try_join_chat(client, entity)
                        if ok:
                            rejoined += 1
                            joined = True
                        else:
                            logging.info(f"[acc {account_id}] '{title}' — {reason}")
                    else:
                        try:
                            entity = await client.get_entity(chat_id)
                            ok, reason = await try_join_chat(client, entity)
                            if ok:
                                rejoined += 1
                                joined = True
                            else:
                                logging.info(f"[acc {account_id}] '{title}' — {reason}")
                        except Exception:
                            joined = False
                except FloodWaitError as e:
                    logging.warning(f"[acc {account_id}] FloodWait {e.seconds}s")
                    await asyncio.sleep(e.seconds)
                    joined = False
                except Exception as e:
                    logging.warning(f"[acc {account_id}] '{title}': {e}")
                    joined = False

                if joined:
                    valid_chats.append(chat)
                else:
                    removed += 1

            if len(valid_chats) != len(chats):
                await update_account_chats(account_id, user_id, valid_chats)
                logging.info(
                    f"[acc {account_id}] Возвращено {rejoined}, удалено {removed}, "
                    f"осталось {len(valid_chats)}"
                )
        except Exception as e:
            logging.error(f"[acc {account_id}] Ошибка проверки: {e}")
        finally:
            await client.disconnect()

    logging.info("Проверка чатов завершена.")

# ---------- ВСПОМОГАТЕЛЬНЫЕ ----------
async def try_join_chat(client, entity):
    """Пытается вступить. Возвращает (ok, reason)."""
    try:
        await client(GetParticipantRequest(channel=entity, participant="me"))
        return True, "already_member"
    except UserAlreadyParticipantError:
        return True, "already_member"
    except Exception:
        pass

    try:
        await client(JoinChannelRequest(entity))
        return True, "joined"
    except UserAlreadyParticipantError:
        return True, "already_member"
    except ChannelsTooMuchError:
        return False, "channels_too_much"
    except ChannelPrivateError:
        return False, "channel_private"
    except FloodWaitError as e:
        await asyncio.sleep(e.seconds)
        return False, f"flood_wait_{e.seconds}s"
    except Exception as e:
        return False, f"error: {type(e).__name__}: {e}"


async def is_chat_active(client, entity, days: int):
    try:
        msgs = await client.get_messages(entity, limit=1)
        if not msgs:
            return False
        last = msgs[0]
        if not last.date:
            return False
        delta = (datetime.utcnow() - last.date.replace(tzinfo=None)).days
        return delta <= days
    except Exception:
        return False


async def join_and_add_chat(account_id: int, user_id: int, chat_input: str):
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        return False, "Аккаунт не найден."

    client = TelegramClient(StringSession(acc['session_string']), API_ID, API_HASH)
    try:
        await client.start()
        try:
            entity = await client.get_entity(chat_input)
        except Exception:
            if 'joinchat' in chat_input or 't.me/joinchat' in chat_input or 't.me/+' in chat_input:
                try:
                    entity = await client(ImportChatInviteRequest(chat_input.split('/')[-1]))
                except Exception as e2:
                    return False, f"Не удалось вступить по ссылке: {e2}"
            else:
                return False, f"Чат не найден. Попробуйте ID или ссылку."

        ok, reason = await try_join_chat(client, entity)
        if not ok:
            return False, f"Не вступил: {reason}"

        chat_id = utils.get_peer_id(entity)
        title = getattr(entity, 'title', None) or str(chat_id)
        username = getattr(entity, 'username', None)
        chats = acc['chats']
        if not any(c['id'] == chat_id for c in chats):
            chats.append({"id": chat_id, "title": title, "username": username})
            await update_account_chats(account_id, user_id, chats)
            return True, f"✅ Чат '{title}' добавлен (ID: {chat_id})."
        else:
            return False, "Этот чат уже есть в списке."
    except Exception as e:
        return False, f"Ошибка: {e}"
    finally:
        await client.disconnect()


async def search_and_join_chats(client, account_id, user_id, keywords,
                                min_participants, max_chats, activity_days):
    acc = await get_account_by_id(account_id, user_id)
    if not acc:
        return [], "Аккаунт не найден."
    existing = acc['chats']
    existing_ids = {c['id'] for c in existing}
    free_slots = max_chats - len(existing)
    if free_slots <= 0:
        return [], f"У аккаунта уже {max_chats} чатов (лимит)."

    added = []
    seen = set()
    skipped = {"participants": 0, "join_failed": 0, "inactive": 0, "no_username": 0}

    for kw in keywords:
        if len(added) >= free_slots:
            break
        try:
            result = await client(functions.contacts.SearchRequest(q=kw, limit=50))
        except FloodWaitError as e:
            logging.warning(f"Search FloodWait {e.seconds}s")
            await asyncio.sleep(e.seconds)
            continue
        except Exception as e:
            logging.error(f"Search error [{kw}]: {e}")
            continue

        for chat in result.chats:
            if len(added) >= free_slots:
                break
            if not isinstance(chat, (tl_types.Channel, tl_types.Chat)):
                continue
            if not getattr(chat, 'username', None):
                skipped["no_username"] += 1
                continue
            if chat.id in seen:
                continue
            seen.add(chat.id)

            participants = getattr(chat, 'participants_count', 0) or 0
            if participants < min_participants:
                skipped["participants"] += 1
                continue

            try:
                entity = await client.get_entity(chat.username)
            except Exception as e:
                logging.warning(f"get_entity @{chat.username}: {e}")
                skipped["join_failed"] += 1
                continue

            peer_id = utils.get_peer_id(entity)
            if peer_id in existing_ids:
                continue

            ok, reason = await try_join_chat(client, entity)
            if not ok:
                logging.warning(f"Не вступил @{chat.username}: {reason}")
                skipped["join_failed"] += 1
                continue

            if not await is_chat_active(client, entity, activity_days):
                try:
                    await client.delete_dialog(entity)
                except Exception:
                    pass
                skipped["inactive"] += 1
                continue

            title = getattr(entity, 'title', None) or chat.username
            username = getattr(entity, 'username', None) or chat.username
            existing.append({"id": peer_id, "title": title, "username": username})
            added.append({"id": peer_id, "title": title, "username": username})
            existing_ids.add(peer_id)
            await update_account_chats(account_id, user_id, existing)

    if not added:
        summary = (
            f"Ничего не добавлено.\n"
            f"Пропущено: мало участников — {skipped['participants']}, "
            f"не вступил — {skipped['join_failed']}, "
            f"неактивные — {skipped['inactive']}, "
            f"без username — {skipped['no_username']}."
        )
        return [], summary
    return added, None

