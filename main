    last = m.text.strip()
    if len(last) > 64:
        await m.answer("Макс 64.")
        return
    data = await st.get_data()
    acc = await get_account(data["acc_id"], m.from_user.id)
    client = make_client(acc["session_string"])
    try:
        await client.start()
        me = await client.get_me()
        await client(UpdateProfileRequest(first_name=me.first_name if me.first_name else None, last_name=last or None))
        await m.answer(f"✅ Фамилия: {last or '(пусто)'}")
    except FloodWaitError as e:
        await m.answer(f"Подожди {e.seconds} сек.")
    except Exception as e:
        await m.answer(f"❌ {e}")
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    await st.clear()


@dp.callback_query(F.data.startswith("prof_user_"))
async def prof_user_start(cb: types.CallbackQuery, st: FSMContext):
    acc_id = int(cb.data.split("_")[2])
    await st.update_data(acc_id=acc_id)
    await cb.message.answer("Введи юзернейм (5–32, a-z0-9_). «-» = удалить.")
    await st.set_state(S_prof.uname)
    await cb.answer()


@dp.message(S_prof.uname)
async def prof_user_apply(m: types.Message, st: FSMContext):
    u = m.text.strip().lstrip("@")
    if u == "-":
        u = ""
    elif len(u) < 5 or len(u) > 32 or not all(c.isalnum() or c == "_" for c in u):
        await m.answer("Неверный формат.")
        return
    data = await st.get_data()
    acc = await get_account(data["acc_id"], m.from_user.id)
    client = make_client(acc["session_string"])
    try:
        await client.start()
        try:
            await client(UpdateUsernameRequest(username=u))
        except UsernameOccupiedError:
            await m.answer("❌ Занят.")
            return
        except UsernameInvalidError:
            await m.answer("❌ Неверный.")
            return
        await save_username(data["acc_id"], m.from_user.id, u or None)
        await m.answer(f"✅ @{u if u else '(удалён)'}")
    except FloodWaitError as e:
        await m.answer(f"Подожди {e.seconds} сек.")
    except Exception as e:
        await m.answer(f"❌ {e}")
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    await st.clear()


@dp.callback_query(F.data.startswith("prof_av_"))
async def prof_av_start(cb: types.CallbackQuery, st: FSMContext):
    acc_id = int(cb.data.split("_")[2])
    await st.update_data(acc_id=acc_id)
    await cb.message.answer("Отправь фото или «-» для удаления.")
    await st.set_state(S_prof.avatar)
    await cb.answer()


@dp.message(S_prof.avatar, F.photo | F.text)
async def prof_av_apply(m: types.Message, st: FSMContext):
    data = await st.get_data()
    acc = await get_account(data["acc_id"], m.from_user.id)
    if not acc:
        await m.answer("Не найден.")
        await st.clear()
        return
    client = make_client(acc["session_string"])
    try:
        await client.start()
        if m.text and m.text.strip() == "-":
            photos = await client(GetUserPhotosRequest(user_id="me", offset=0, max_id=0, limit=100))
            if photos.photos:
                await client(DeletePhotosRequest(id=photos.photos))
            await m.answer("✅ Аватар удалён.")
        elif m.photo:
            file = await m.bot.get_file(m.photo[-1].file_id)
            path = f"/tmp/av_{data['acc_id']}_{m.message_id}.jpg"
            await m.bot.download_file(file.file_path, path)
            try:
                up = await client.upload_file(path)
                await client(UploadProfilePhotoRequest(file=up))
                await m.answer("✅ Аватар установлен.")
            finally:
                try:
                    os.remove(path)
                except Exception:
                    pass
        else:
            await m.answer("Отправь фото или «-».")
            return
    except FloodWaitError as e:
        await m.answer(f"Подожди {e.seconds} сек.")
    except Exception as e:
        await m.answer(f"❌ {e}")
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    await st.clear()


@dp.message()
async def fallback(m: types.Message):
    pass


async def main():
    logging.info("=== BOT STARTING ===")
    await init_db()
    if not scheduler.running:
        scheduler.start()
    await restore_jobs()
    bot = Bot(token=BOT_TOKEN)
    try:
        await bot.delete_webhook(drop_pending_updates=True)
    except Exception as e:
        logging.warning(f"delete_webhook: {e}")
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
