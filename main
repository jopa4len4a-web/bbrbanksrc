        [InlineKeyboardButton(text="🔙 Назад к списку", callback_data="back_to_accounts")]
    ])

def chats_inline_keyboard(account_id: int, chats: list):
    kb = []
    for i, chat in enumerate(chats):
        title = chat.get('title', str(chat['id']))
        kb.append([InlineKeyboardButton(text=f"❌ {title}", callback_data=f"acc_del_chat_{account_id}_{i}")])
    kb.append([InlineKeyboardButton(text="➕ Добавить чат вручную", callback_data=f"acc_add_chat_{account_id}")])
    kb.append([InlineKeyboardButton(text="📩 Последние 3", callback_data=f"acc_show_msgs_{account_id}")])
    kb.append([InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_back_{account_id}")])
    return InlineKeyboardMarkup(inline_keyboard=kb)

