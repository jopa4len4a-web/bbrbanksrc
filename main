@dp.callback_query(F.data == "settings_interval")
async def settings_interval(callback: types.CallbackQuery):
    settings = await get_user_settings(callback.from_user.id)
    current = settings['interval_seconds']
    desc = f"{current//3600} ч {current%3600//60} мин" if current >= 3600 else f"{current//60} мин"
    await callback.message.edit_text(
        f"Текущий интервал: {desc}\nВыберите новый:",
        reply_markup=interval_keyboard()
    )
    await callback.answer()

@dp.callback_query(F.data.startswith("set_int_"))
async def set_interval(callback: types.CallbackQuery):
    seconds = int(callback.data.split("_")[2])
    await update_user_setting(callback.from_user.id, "interval_seconds", seconds)
    job_id = await get_job_id(callback.from_user.id)
    if job_id:
        await stop_scheduler_for_user(callback.from_user.id)
        await start_scheduler_for_user(callback.from_user.id)
    await callback.answer(f"Интервал {seconds} сек")
    await callback.message.edit_text(f"Установлено {seconds} сек.", reply_markup=settings_keyboard())

