API_ID = 2040
API_HASH = "b18441a1ff607e10a989891a5462e627"

BOT_TOKEN = os.getenv("BOT_TOKEN")
if not BOT_TOKEN:
    raise ValueError("BOT_TOKEN не задан")

DB_PATH = os.getenv("DB_PATH", "bot_data.db")

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")

INVITE_BATCH = 20
DEFAULT_INVITE_LIMIT = 200
DEFAULT_PARSE_LIMIT = 500
DEFAULT_DELAY = 1.5
DEFAULT_INTERVAL = 3600
PROCESS_INTERVAL = 30

scheduler = AsyncIOScheduler()
dp = Dispatcher(storage=MemoryStorage())
RUNNING = set()


def make_client(session_string):
    return TelegramClient(
        StringSession(session_string) if session_string else StringSession(),
        API_ID, API_HASH,
        device_model="PC 64bit",
        system_version="Windows 10",
        app_version="4.16.8",
        lang_code="ru",
        system_lang_code="ru",
    )


async def init_db():
    logging.info("init_db start")
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute('''CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY, username TEXT,
            invite_limit INTEGER DEFAULT 200, parse_limit INTEGER DEFAULT 500,
            delay REAL DEFAULT 1.5, interval INTEGER DEFAULT 3600)''')
        await db.execute('''CREATE TABLE IF NOT EXISTS accounts (
            id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, phone TEXT, username TEXT,
            session_string TEXT, is_active INTEGER DEFAULT 1,
            invited_count INTEGER DEFAULT 0, parsed_count INTEGER DEFAULT 0, sent_count INTEGER DEFAULT 0,
            sources TEXT DEFAULT '[]', target TEXT DEFAULT 'null',
            chats TEXT DEFAULT '[]')''')
        await db.execute('''CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, text TEXT)''')
        await db.execute('''CREATE TABLE IF NOT EXISTS queue (
            id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, account_id INTEGER,
            target_id INTEGER, target_type TEXT, target_access_hash INTEGER, uid INTEGER,
            user_username TEXT, first_name TEXT, last_name TEXT, access_hash INTEGER,
            status TEXT DEFAULT 'pending', error TEXT)''')
        await db.execute('''CREATE TABLE IF NOT EXISTS invited (
            id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, target_id INTEGER, uid INTEGER,
            UNIQUE(user_id, target_id, uid))''')
        await db.execute('''CREATE TABLE IF NOT EXISTS jobs (
            user_id INTEGER PRIMARY KEY, mailing_id TEXT, parsing_id TEXT)''')
        await db.commit()
    logging.info("init_db done")


async def ensure_user(uid, uname=None):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT user_id FROM users WHERE user_id = ?", (uid,))
        r = await cur.fetchone()
        if not r:
            await db.execute("INSERT INTO users (user_id, username) VALUES (?, ?)", (uid, uname))
        elif uname:
            await db.execute("UPDATE users SET username = ? WHERE user_id = ?", (uname, uid))
        await db.commit()


async def get_settings(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute(
            "SELECT invite_limit, parse_limit, delay, interval FROM users WHERE user_id = ?", (uid,))
        r = await cur.fetchone()
        if r:
            return {"invite_limit": r[0], "parse_limit": r[1], "delay": r[2], "interval": r[3]}
        return {"invite_limit": DEFAULT_INVITE_LIMIT, "parse_limit": DEFAULT_PARSE_LIMIT,
                "delay": DEFAULT_DELAY, "interval": DEFAULT_INTERVAL}


async def set_setting(uid, key, val):
    if key not in {"invite_limit", "parse_limit", "delay", "interval"}:
        return
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(f"UPDATE users SET {key} = ? WHERE user_id = ?", (val, uid))
        await db.commit()


async def get_accounts(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute(
            "SELECT id, phone, username, session_string, is_active, invited_count, parsed_count, sent_count, sources, target, chats FROM accounts WHERE user_id = ?",
            (uid,))
        rows = await cur.fetchall()
        out = []
        for r in rows:
            def jload(v, d):
                if not v or v == "null":
                    return d
                try:
                    return json.loads(v)
                except Exception:
                    return d
            out.append({"id": r[0], "phone": r[1], "username": r[2], "session_string": r[3],
                        "is_active": bool(r[4]), "invited_count": r[5], "parsed_count": r[6],
                        "sent_count": r[7],
                        "sources": jload(r[8], []),
                        "target": jload(r[9], None),
                        "chats": jload(r[10], [])})
        return out


async def get_account(acc_id, uid):
    for a in await get_accounts(uid):
        if a["id"] == acc_id:
            return a
    return None


async def add_account(uid, phone, uname, sess):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("INSERT INTO accounts (user_id, phone, username, session_string) VALUES (?, ?, ?, ?)",
                         (uid, phone, uname, sess))
        await db.commit()


async def toggle_acc(acc_id, uid, active):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET is_active = ? WHERE id = ? AND user_id = ?",
                         (1 if active else 0, acc_id, uid))
        await db.commit()


async def save_sources(acc_id, uid, sources):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET sources = ? WHERE id = ? AND user_id = ?",
                         (json.dumps(sources), acc_id, uid))
        await db.commit()


async def save_target(acc_id, uid, target):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET target = ? WHERE id = ? AND user_id = ?",
                         (json.dumps(target) if target is not None else "null", acc_id, uid))
        await db.commit()


async def save_chats(acc_id, uid, chats):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET chats = ? WHERE id = ? AND user_id = ?",
                         (json.dumps(chats), acc_id, uid))
        await db.commit()


async def save_username(acc_id, uid, uname):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET username = ? WHERE id = ? AND user_id = ?", (uname, acc_id, uid))
        await db.commit()


async def inc_parsed(acc_id, uid, d):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET parsed_count = parsed_count + ? WHERE id = ? AND user_id = ?",
                         (d, acc_id, uid))
        await db.commit()


async def inc_invited(acc_id, uid, d=1):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET invited_count = invited_count + ? WHERE id = ? AND user_id = ?",
                         (d, acc_id, uid))
        await db.commit()


async def inc_sent(acc_id, uid, d=1):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE accounts SET sent_count = sent_count + ? WHERE id = ? AND user_id = ?",
                         (d, acc_id, uid))
        await db.commit()


async def del_account(acc_id, uid):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM accounts WHERE id = ? AND user_id = ?", (acc_id, uid))
        await db.commit()


async def get_messages(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT id, text FROM messages WHERE user_id = ?", (uid,))
        return [{"id": r[0], "text": r[1]} for r in await cur.fetchall()]


async def add_message(uid, text):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("INSERT INTO messages (user_id, text) VALUES (?, ?)", (uid, text))
        await db.commit()


async def del_message(mid, uid):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM messages WHERE id = ? AND user_id = ?", (mid, uid))
        await db.commit()


async def already_invited(uid, target_id, tg_id):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT 1 FROM invited WHERE user_id = ? AND target_id = ? AND uid = ?",
                               (uid, target_id, tg_id))
        return bool(await cur.fetchone())


async def already_pending(uid, target_id, tg_id):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute(
            "SELECT 1 FROM queue WHERE user_id = ? AND target_id = ? AND uid = ? AND status = 'pending'",
            (uid, target_id, tg_id))
        return bool(await cur.fetchone())


async def enqueue(uid, acc_id, target, u):
    if await already_invited(uid, target["id"], u["id"]):
        return False
    if await already_pending(uid, target["id"], u["id"]):
        return False
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute('''INSERT INTO queue (user_id, account_id, target_id, target_type,
            target_access_hash, uid, user_username, first_name, last_name, access_hash)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)''', (
            uid, acc_id, target["id"], target.get("type", "channel"), target.get("access_hash", 0),
            u["id"], u["username"], u["first_name"], u["last_name"], u["access_hash"]))
        await db.commit()
    return True


async def pop_batch(uid, limit=20):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute('''SELECT id, account_id, target_id, target_type, target_access_hash,
            uid, user_username, first_name, last_name, access_hash
            FROM queue WHERE user_id = ? AND status = 'pending' ORDER BY id LIMIT ?''', (uid, limit))
        rows = await cur.fetchall()
        return [{"id": r[0], "account_id": r[1], "target_id": r[2], "target_type": r[3],
                 "target_access_hash": r[4], "uid": r[5], "user_username": r[6],
                 "first_name": r[7], "last_name": r[8], "access_hash": r[9]} for r in rows]


async def set_status(qid, status, err=None):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE queue SET status = ?, error = ? WHERE id = ?", (status, err, qid))
        await db.commit()


async def mark_invited(uid, target_id, tg_id):
    async with aiosqlite.connect(DB_PATH) as db:
        try:
            await db.execute("INSERT OR IGNORE INTO invited (user_id, target_id, uid) VALUES (?, ?, ?)",
                             (uid, target_id, tg_id))
            await db.commit()
        except Exception:
            pass


async def clear_queue(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM queue WHERE user_id = ? AND status != 'invited'", (uid,))
        await db.commit()


async def stats(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT status, COUNT(*) FROM queue WHERE user_id = ? GROUP BY status", (uid,))
        return {r[0]: r[1] for r in await cur.fetchall()}


# ---------- JOB-ХРАНИЛИЩЕ ----------
async def save_jobs(uid, mailing_id=None, parsing_id=None):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT mailing_id, parsing_id FROM jobs WHERE user_id = ?", (uid,))
        r = await cur.fetchone()
        old_m = r[0] if r else None
        old_p = r[1] if r else None
        new_m = mailing_id if mailing_id is not None else old_m
        new_p = parsing_id if parsing_id is not None else old_p
        await db.execute("INSERT OR REPLACE INTO jobs (user_id, mailing_id, parsing_id) VALUES (?, ?, ?)",
                         (uid, new_m, new_p))
        await db.commit()


async def get_jobs(uid):
    async with aiosqlite.connect(DB_PATH) as db:
        cur = await db.execute("SELECT mailing_id, parsing_id FROM jobs WHERE user_id = ?", (uid,))
        r = await cur.fetchone()
        return (r[0], r[1]) if r else (None, None)


# ---------- РАССЫЛКА ----------
async def send_messages_for_user(uid):
    try:
        accounts = [a for a in await get_accounts(uid) if a["is_active"]]
        messages = await get_messages(uid)
        if not accounts or not messages:
            return
        for acc in accounts:
            if not acc["chats"]:
                continue
            client = make_client(acc["session_string"])
            try:
                await client.start()
                for chat in acc["chats"]:
                    for msg in messages:
                        try:
                            await client.send_message(chat["id"], msg["text"])
                            await inc_sent(acc["id"], uid, 1)
                            await asyncio.sleep(1)
                        except FloodWaitError as e:
                            await asyncio.sleep(e.seconds)
                        except Exception as e:
                            logging.error(f"send[{acc['phone']} -> {chat.get('id')}]: {e}")
            except Exception as e:
                logging.error(f"mailing client[{acc['phone']}]: {e}")
            finally:
                try:
                    await client.disconnect()
                except Exception:
                    pass
    except Exception as e:
        logging.error(f"send_messages_for_user[{uid}]: {e}")


async def start_mailing(uid):
    mid, _ = await get_jobs(uid)
    if mid:
        try:
            scheduler.get_job(mid)
            return False
        except JobLookupError:
            pass
    settings = await get_settings(uid)
    job = scheduler.add_job(send_messages_for_user, "interval",
                            seconds=settings["interval"], args=[uid],
                            id=f"mail_{uid}", replace_existing=True)
    await save_jobs(uid, mailing_id=job.id)
    asyncio.create_task(send_messages_for_user(uid))
    return True


async def stop_mailing(uid):
    mid, _ = await get_jobs(uid)
    if mid:
        try:
            scheduler.remove_job(mid)
        except JobLookupError:
            pass
        await save_jobs(uid, mailing_id="")
    await save_jobs(uid, mailing_id="")


# ---------- ПАРСИНГ + ИНВАЙТ ----------
async def parse_source(client, src, limit):
    try:
        entity = await client.get_entity(src.get("id") or src.get("username"))
    except Exception as e:
        logging.warning(f"parse_source {src.get('title')}: {e}")
        return []
    if not isinstance(entity, tl_types.Channel):
        return []
    result = []
    offset = 0
    step = 200
    while len(result) < limit:
        try:
            part = await client(functions.channels.GetParticipantsRequest(
                channel=entity, filter=ChannelParticipantsSearch(''), offset=offset, limit=step, hash=0))
        except Exception as e:
            logging.warning(f"GetParticipants {src.get('title')}: {e}")
            break
        if not part or not part.users:
            break
        for u in part.users:
            if u.bot or not getattr(u, "username", None) or not getattr(u, "access_hash", None):
                continue
            result.append({"id": u.id, "username": u.username,
                           "first_name": u.first_name or "", "last_name": u.last_name or "",
                           "access_hash": u.access_hash})
            if len(result) >= limit:
                break
        offset += step
        if len(part.users) < step:
            break
    return result


async def is_in_target(client, target, tg_id):
    try:
        entity = await client.get_entity(target["id"])
        await client(functions.channels.GetParticipantRequest(channel=entity, participant=tg_id))
        return True
    except Exception:
        return False


async def invite(client, target, u):
    try:
        await client(AddContactRequest(
            id=InputPeerUser(u["id"], u["access_hash"]),
            first_name=u["first_name"] or u["username"] or "User",
            last_name=u["last_name"] or "", phone="", add_phone_privacy_exception=False))
    except FloodWaitError as e:
        await asyncio.sleep(e.seconds)
        return False, f"flood_contact_{e.seconds}s"
    except UserPrivacyRestrictedError:
        return False, "privacy_restricted"
    except Exception as e:
        logging.info(f"AddContact skip: {e}")

    try:
        if target["type"] == "channel":
            await client(InviteToChannelRequest(
                channel=InputPeerChannel(target["id"], target["access_hash"]),
                users=[InputPeerUser(u["id"], u["access_hash"])]))
        else:
            await client(AddChatUserRequest(
                chat_id=target["id"],
                user_id=InputPeerUser(u["id"], u["access_hash"]), fwd_limit=100))
        return True, "invited"
    except UserAlreadyParticipantError:
        return False, "already_participant"
    except UserNotMutualContactError:
        return False, "not_mutual_contact"
    except UserChannelsTooMuchError:
        return False, "target_channels_too_much"
    except ChatAdminRequiredError:
        return False, "no_admin_rights"
    except PeerFloodError:
        return False, "peer_flood"
    except FloodWaitError as e:
        await asyncio.sleep(e.seconds)
        return False, f"flood_invite_{e.seconds}s"
    except Exception as e:
        return False, f"error: {type(e).__name__}: {e}"


async def parse_and_invite_for_user(uid):
    if uid in RUNNING:
        return
    RUNNING.add(uid)
    try:
        settings = await get_settings(uid)
        accounts = [a for a in await get_accounts(uid) if a["is_active"]]

        for acc in accounts:
            if not acc["sources"] or not acc["target"]:
                continue
            client = make_client(acc["session_string"])
            try:
                await client.start()
                total = 0
                for src in acc["sources"]:
                    users = await parse_source(client, src, settings["parse_limit"])
                    for u in users:
                        if await is_in_target(client, acc["target"], u["id"]):
                            continue
                        if await enqueue(uid, acc["id"], acc["target"], u):
                            total += 1
                if total:
                    await inc_parsed(acc["id"], uid, total)
            except Exception as e:
                logging.error(f"parse[{acc['phone']}]: {e}")
            finally:
                try:
                    await client.disconnect()
                except Exception:
                    pass

        batch = await pop_batch(uid, INVITE_BATCH)
        if not batch:
            return
        by_acc = {}
        for it in batch:
            by_acc.setdefault(it["account_id"], []).append(it)
        for acc_id, items in by_acc.items():
            acc = next((a for a in accounts if a["id"] == acc_id), None)
            if not acc:
                for it in items:
                    await set_status(it["id"], "skipped", "account_inactive")
                continue
            if acc["invited_count"] >= settings["invite_limit"]:
                for it in items:
                    await set_status(it["id"], "skipped", "daily_limit")
                continue
            client = make_client(acc["session_string"])
            try:
                await client.start()
                for it in items:
                    if acc["invited_count"] >= settings["invite_limit"]:
                        await set_status(it["id"], "skipped", "daily_limit")
                        continue
                    target = {"id": it["target_id"], "type": it["target_type"],
                              "access_hash": it["target_access_hash"]}
                    u = {"id": it["uid"], "username": it["user_username"],
                         "first_name": it["first_name"], "last_name": it["last_name"],
                         "access_hash": it["access_hash"]}
                    ok, reason = await invite(client, target, u)
                    if ok:
                        await set_status(it["id"], "invited")
                        await mark_invited(uid, it["target_id"], it["uid"])
                        await inc_invited(acc_id, uid, 1)
                        acc["invited_count"] += 1
                    else:
                        if reason in ("already_participant", "not_mutual_contact",
                                      "target_channels_too_much", "privacy_restricted",
                                      "no_admin_rights", "peer_flood"):
                            await set_status(it["id"], "skipped", reason)
                            await mark_invited(uid, it["target_id"], it["uid"])
                        else:
                            await set_status(it["id"], "failed", reason)
                    await asyncio.sleep(settings["delay"])
            except Exception as e:
                logging.error(f"invite[{acc['phone']}]: {e}")
                for it in items:
                    await set_status(it["id"], "failed", str(e))
            finally:
                try:
                    await client.disconnect()
                except Exception:
                    pass
    except Exception as e:
        logging.error(f"parse_and_invite[{uid}]: {e}")
    finally:
        RUNNING.discard(uid)


async def start_parsing(uid):
    _, pid = await get_jobs(uid)
    if pid:
        try:
            scheduler.get_job(pid)
            return False
        except JobLookupError:
            pass
    job = scheduler.add_job(parse_and_invite_for_user, "interval",
                            seconds=PROCESS_INTERVAL, args=[uid],
                            id=f"parse_{uid}", replace_existing=True)
    await save_jobs(uid, parsing_id=job.id)
    asyncio.create_task(parse_and_invite_for_user(uid))
    return True


async def stop_parsing(uid):
    _, pid = await get_jobs(uid)
    if pid:
        try:
            scheduler.remove_job(pid)
        except JobLookupError:
            pass
    await save_jobs(uid, parsing_id="")


async def restore_jobs():
    logging.info("restore_jobs start")
    try:
        async with aiosqlite.connect(DB_PATH) as db:
            cur = await db.execute("SELECT user_id, mailing_id, parsing_id FROM jobs")
            for r in await cur.fetchall():
                uid, mid, pid = r
                if mid:
                    try:
                        scheduler.get_job(mid)
                    except JobLookupError:
                        await start_mailing(uid)
                if pid:
                    try:
                        scheduler.get_job(pid)
                    except JobLookupError:
                        await start_parsing(uid)
        logging.info("restore_jobs done")
    except Exception as e:
        logging.error(f"restore_jobs: {e}")


async def is_mailing_running(uid):
    mid, _ = await get_jobs(uid)
    if not mid:
        return False
    try:
        scheduler.get_job(mid)
        return True
    except JobLookupError:
        return False


async def is_parsing_running(uid):
    _, pid = await get_jobs(uid)
    if not pid:
        return False
    try:
        scheduler.get_job(pid)
        return True
    except JobLookupError:
        return False


async def get_dialogs(acc, limit=200):
    client = make_client(acc["session_string"])
    out = []
    try:
        await client.start()
        dialogs = await client.get_dialogs(limit=limit)
        for d in dialogs:
            if not d.is_group and not d.is_channel:
                continue
            try:
                peer_id = utils.get_peer_id(d.entity)
                access_hash = getattr(d.entity, "access_hash", 0) or 0
                is_broadcast = bool(getattr(d.entity, "broadcast", False))
                is_megagroup = bool(getattr(d.entity, "megagroup", False))
                out.append({"id": peer_id, "access_hash": access_hash,
                            "title": d.title or str(peer_id),
                            "username": getattr(d.entity, "username", None),
                            "type": "channel" if (is_broadcast or is_megagroup) else "chat"})
            except Exception:
                continue
    except Exception as e:
        logging.error(f"get_dialogs: {e}")
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    return out


# ---------- КЛАВИАТУРЫ ----------
def main_menu():
    return ReplyKeyboardMarkup(keyboard=[
        [KeyboardButton(text="📋 Аккаунты"), KeyboardButton(text="⚙️ Настройки")],
        [KeyboardButton(text="✉️ Рассылка"), KeyboardButton(text="🔍 Парсинг")],
    ], resize_keyboard=True)


def accounts_menu_reply(accounts):
    kb = []
    for a in accounts:
        st = "✅" if a["is_active"] else "❌"
        un = f"@{a['username']}" if a["username"] else "без ника"
        kb.append([KeyboardButton(text=f"{st} {un} • {a['phone']}")])
    kb.append([KeyboardButton(text="➕ Добавить аккаунт")])
    kb.append([KeyboardButton(text="🔙 Назад")])
    return ReplyKeyboardMarkup(keyboard=kb, resize_keyboard=True)


def account_menu_inline(acc_id, is_active):
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🔄 Выключить" if is_active else "🔄 Включить",
                              callback_data=f"acc_toggle_{acc_id}")],
        [InlineKeyboardButton(text="✉️ Чаты рассылки", callback_data=f"acc_chats_{acc_id}"),
         InlineKeyboardButton(text="📥 Источники", callback_data=f"acc_src_{acc_id}")],
        [InlineKeyboardButton(text="📤 Цель", callback_data=f"acc_tgt_{acc_id}"),
         InlineKeyboardButton(text="✏️ Профиль", callback_data=f"acc_prof_{acc_id}")],
        [InlineKeyboardButton(text="🗑 Удалить", callback_data=f"acc_del_{acc_id}"),
         InlineKeyboardButton(text="🔙 К списку", callback_data="back_accs")],
    ])


def chats_menu(acc_id, chats):
    kb = []
    for i, c in enumerate(chats):
        kb.append([InlineKeyboardButton(text=f"❌ {c.get('title', c['id'])}",
                                        callback_data=f"chat_del_{acc_id}_{i}")])
    kb.append([InlineKeyboardButton(text="📋 Выбрать из чатов", callback_data=f"chat_pick_{acc_id}")])
    kb.append([InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_back_{acc_id}")])
    return InlineKeyboardMarkup(inline_keyboard=kb)


def sources_menu(acc_id, sources):
    kb = []
    for i, s in enumerate(sources):
        kb.append([InlineKeyboardButton(text=f"❌ {s.get('title', s['id'])}",
                                        callback_data=f"src_del_{acc_id}_{i}")])
    kb.append([InlineKeyboardButton(text="📋 Выбрать из чатов", callback_data=f"src_pick_{acc_id}")])
    kb.append([InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_back_{acc_id}")])
    return InlineKeyboardMarkup(inline_keyboard=kb)


def target_menu(acc_id, target):
    kb = []
    if target:
        kb.append([InlineKeyboardButton(text=f"❌ {target.get('title', target['id'])}",
                                        callback_data=f"tgt_del_{acc_id}")])
    kb.append([InlineKeyboardButton(text="📋 Выбрать из чатов", callback_data=f"tgt_pick_{acc_id}")])
    kb.append([InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_back_{acc_id}")])
    return InlineKeyboardMarkup(inline_keyboard=kb)


def picker_menu(acc_id, dialogs, kind):
    kb = []
    for i, d in enumerate(dialogs):
        kb.append([InlineKeyboardButton(text=f"{d['title'][:42]}",
                                        callback_data=f"{kind}_add_{acc_id}_{i}")])
    kb.append([InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_back_{acc_id}")])
    return InlineKeyboardMarkup(inline_keyboard=kb)


