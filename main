class S_acc(StatesGroup):
    phone = State()
    code = State()
    password = State()


class S_prof(StatesGroup):
    first = State()
    last = State()
    uname = State()
    avatar = State()


class S_set(StatesGroup):
    inv_limit = State()
    parse_limit = State()
    delay = State()
    msg = State()


