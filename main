@dp.callback_query(F.data.startswith("acc_prof_"))
async def show_profile(callback: types.CallbackQuery):
    account_id = int(callback.data.split("_")[2])
    acc = await get_account(account_id, callback.from_user.id)
    if not acc:
        await callback.answer("Не найден.", show_alert=True)
        return
    info = "✏️ Профиль\n\n"
    client = make_client(acc["session_string"])
    try:
        await client.start()
        me = await client.get_me()
        info += (
            f"👤 Имя: {me.first_name or '—'}\n"
            f"📛 Фамилия: {me.last_name or '—'}\n"
            f"🔗 Юзернейм: @{me.username if me.username else '—'}\n"
            f"📞 Телефон: {me.phone or acc['phone']}"
        )
    except Exception as e:
        info += f"Ошибка: {e}"
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    try:
        await callback.message.edit_text(info, reply_markup=profile_menu(account_id))
    except TelegramBadRequest:
        pass
    await callback.answer()


@dp.callback_query(F.data.startswith("prof_first_"))
async def prof_first_start(callback: types.CallbackQuery, state: FSMContext):
    account_id = int(callback.data.split("_")[2])
    await state.update_data(account_id=account_id)
    await callback.message.answer("Введите новое имя:")
    await state.set_state(ProfileEditStates.waiting_first_name)
    await callback.answer()


@dp.message(ProfileEditStates.waiting_first_name)
async def prof_set_first(message: types.Message, state: FSMContext):
    new_name = message.text.strip()
    if len(new_name) > 64 or not new_name:
        await message.answer("Имя 1-64 символа.")
        return
    data = await state.get_data()
    account_id = data["account_id"]
    acc = await get_account(account_id, message.from_user.id)
    client = make_client(acc["session_string"])
    try:
        await client.start()
        me = await client.get_me()
        await client(UpdateProfileRequest(first_name=new_name, last_name=me.last_name or ""))
        await message.answer(f"✅ Имя: «{new_name}».")
    except FloodWaitError as e:
        await message.answer(f"Подожди {e.seconds} сек.")
    except Exception as e:
        await message.answer(f"❌ Ошибка: {e}")
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass
    await state.clear()


