    await st.set_state(S_set.delay)
    await cb.answer()


@dp.message(S_set.delay)
async def set_delay_save(m: types.Message, st: FSMContext):
    try:
        v = float(m.text.strip().replace(",", "."))
        if v < 0.5 or v > 60:
            raise ValueError
        await set_setting(m.from_user.id, "delay", v)
        await m.answer(f"✅ {v} сек")
    except ValueError:
        await m.answer("Число 0.5–60.")
    await st.clear()


